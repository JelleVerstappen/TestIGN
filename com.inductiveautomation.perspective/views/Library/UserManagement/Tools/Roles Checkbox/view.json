{
  "custom": {},
  "params": {
    "azure": false,
    "role": "",
    "selected": false
  },
  "propConfig": {
    "params.azure": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.role": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selected": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 75,
      "width": 198
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Checkbox"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{view.params.azure}"
              },
              "type": "expr"
            }
          },
          "props.selected": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.selected"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.role"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Library/UserManagement/InputFont"
          }
        },
        "type": "ia.input.checkbox"
      },
      {
        "meta": {
          "name": "Label_0"
        },
        "position": {
          "basis": "3px",
          "grow": 1,
          "shrink": 0
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "3px",
          "grow": 1,
          "shrink": 0
        },
        "props": {
          "style": {
            "borderTopColor": "#D4D4D4",
            "borderTopStyle": "solid",
            "borderTopWidth": "1px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Library/UserManagement/MainFont",
        "overflow": "visible"
      }
    },
    "type": "ia.container.flex"
  }
}