{
  "custom": {},
  "params": {
    "login": true
  },
  "propConfig": {
    "params.feature": {
      "paramDirection": "input"
    },
    "params.login": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tier1": {
      "paramDirection": "input"
    },
    "params.tier2": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 64,
      "width": 246
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon_0"
        },
        "position": {
          "basis": "42px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!{session.props.auth.authenticated}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "path": "material/account_circle",
          "style": {
            "margin": "0 5px 0 0"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Image",
          "tooltip": {
            "delay": 1000,
            "enabled": true,
            "location": "bottom",
            "tail": false,
            "text": "Click to Change Your Picture"
          }
        },
        "position": {
          "basis": "54px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "session.props.auth.authenticated"
              },
              "type": "property"
            }
          },
          "props.source": {
            "binding": {
              "config": {
                "struct": {
                  "gatewayAddress": "{session.props.gateway.address}",
                  "username": "{session.props.auth.user.userName}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\timport base64\n\n\tuserName \u003d self.session.props.auth.user.userName\n\tnoImage \u003d \u0027\u0027\u0027data:imagef;base64,\u003d\u0027\u0027\u0027\n\ttry:\n\t\tresult \u003d system.db.runPrepQuery(\"SELECT image from ignition_users WHERE username \u003d ?\", [userName], ata.config.userDB)\n\texcept:\n\t\treturn noImage\n\tif len(result) \u003d\u003d 0: # There is no image save for this user in DB\n\t\treturn noImage\n\telse:\n\t\tbytes \u003d result[0][0]\n\t\tif bytes \u003d\u003d None: # There is no image save for this user in DB\n\t\t\treturn noImage\n\t\telse:\t\n\t\t\tencoded \u003d base64.b64encode(bytes)\n\t\t\treturn \"data:imagef;base64,%s\"%encoded",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "fit": {
            "height": 30,
            "mode": "fill",
            "width": 30
          },
          "style": {
            "border": "2px #FAFCFF solid",
            "border-radius": "50%"
          },
          "tint": {
            "color": "#FAFCFF"
          }
        },
        "type": "ia.display.image"
      },
      {
        "events": {
          "component": {
            "onFileReceived": {
              "config": {
                "script": "\tusername \u003d self.session.props.auth.user.userName\n\tbytes \u003d event.file.getBytes()\n\t\n\tata.user.updatePicture(username, bytes)\n\tself.getSibling(\"Image\").refreshBinding(\"props.source\")\t\t\t\t\t\t   \n\t\t\t\t\t\t\t   "
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "FileUpload",
          "tooltip": {
            "delay": 1000,
            "enabled": true,
            "text": "Click to Upload Your Picture"
          }
        },
        "position": {
          "basis": "54px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "session.props.auth.authenticated"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "fileSizeLimit": 1,
          "fileUploadIcon": {
            "path": "",
            "style": {
              "classes": ""
            }
          },
          "maxUploads": 1,
          "style": {
            "backgroundColor": "#FFFFFF00",
            "borderStyle": "none",
            "classes": "",
            "cursor": "pointer",
            "margin": "0  10px 0 -54px"
          },
          "supportedFileTypes": [
            "jpg"
          ]
        },
        "type": "ia.input.fileupload"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\n\tif self.session.props.auth.authenticated:\n\t\tsystem.perspective.logout()\n\telse:\n\t\tsystem.perspective.login()\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "hasDelegate": true,
              "name": "username",
              "tooltip": {
                "enabled": true,
                "location": "bottom",
                "style": {
                  "textAlign": "left",
                  "whiteSpace": "pre-wrap"
                },
                "tail": false
              }
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "config": {
                    "expression": "if({session.props.auth.authenticated}, \r\n\"Click to Sign Out\",\r\n\"Click to Sign In\")"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "struct": {
                      "username": "{session.props.auth.user.userName}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "expression": "\r\nif({value}[\u0027username\u0027]\u003dnull||len({value}[\u0027username\u0027])\u003d0,\"Sign In\",{value}[\u0027username\u0027])",
                      "type": "expression"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "style": {
                "cursor": "pointer"
              },
              "textStyle": {
                "color": "--color3",
                "fontSize": 14,
                "fontWeight": "bold"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\n\tif self.session.props.auth.authenticated:\n\t\tsystem.perspective.logout()\n\telse:\n\t\tsystem.perspective.login()\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "hasDelegate": true,
              "name": "Fullname",
              "tooltip": {
                "enabled": true,
                "location": "bottom",
                "style": {
                  "textAlign": "left",
                  "whiteSpace": "pre-wrap"
                },
                "tail": false,
                "text": "First Name \u0026 Last Name",
                "width": "upper("
              }
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "session.props.auth.user.firstName"
                  },
                  "transforms": [
                    {
                      "expression": "{value} + \" \" + {session.props.auth.user.lastName}",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "color": "--color3",
                "fontSize": 12
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Name"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "ATA/Components/Labels/TextNormal"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tsystem.perspective.logout()\n#\tif self.session.custom.jobcontrol.operatorScreen:\n#\t\tself.session.custom.jobcontrol.selectedOperator \u003d \u0027\u0027\n#\telif self.session.props.auth.authenticated:\n#\t\tsystem.perspective.logout()\n#\telse:\n#\t\tsystem.perspective.login()\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Icon",
          "tooltip": {
            "enabled": true,
            "location": "bottom",
            "tail": false
          }
        },
        "position": {
          "basis": "24px",
          "shrink": 0
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "expression": "if({session.props.auth.authenticated}, \r\n\"Click to Sign Out\",\r\n\"Click to Sign In\")"
              },
              "type": "expr"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.login"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "color": "--color3",
          "path": "material/login",
          "style": {
            "classes": "form-icon-button",
            "margin": 0
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "overflow": "hidden",
        "padding": 5
      }
    },
    "type": "ia.container.flex"
  }
}