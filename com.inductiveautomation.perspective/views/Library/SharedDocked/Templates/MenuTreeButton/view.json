{
  "custom": {},
  "params": {
    "alarmPath": "[NLSTWDYK]Dyka/STW/EXT/E07/Assets/RAW/Alarms/Count/IconPath",
    "enabled": true,
    "menuPath": "",
    "navIcon": "dyka/RawMaterialTranssport",
    "navPath": "/ControlRoom/Assets/RawMaterialTransport/Overview/RawMaterialTransport/E07",
    "text": "Grondstoftransport"
  },
  "propConfig": {
    "params.alarmPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.enabled": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.menuPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.navIcon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.navPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 49,
      "width": 275
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "##### Navigate to screen (if needed) and open the next menu (if needed)\n#\t# Declare variables\n\tmenu \u003d self.view.params.menuPath\n\tnav \u003d self.view.params.navPath\n\t\n#\t# Navigation\n\tif str(nav).strip() not in [\"\", \"None\"]:\n\t\tsystem.perspective.navigate(page \u003d nav)\n\t\n#\t# Menu tree\n\tif str(menu).strip() not in [\"\", \"None\"] is not None:\n\t\tsystem.perspective.sendMessage(messageType \u003d \"alterMenu\", payload \u003d {\"menu\": menu}, scope \u003d \"page\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Button"
        },
        "position": {
          "basis": "34px",
          "grow": 1
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.enabled"
              },
              "type": "property"
            }
          },
          "props.image.icon.path": {
            "binding": {
              "config": {
                "path": "view.params.navIcon"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.text"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "image": {
            "icon": {},
            "width": 35
          },
          "justify": "start",
          "primary": false,
          "style": {
            "classes": "ATA/Components/Buttons/MenuTree"
          },
          "textStyle": {
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.input.button"
      },
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "30px"
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "len(tostr({view.params.alarmPath})) !\u003d 0"
              },
              "type": "expr"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "alarmPath": "{view.params.alarmPath}"
                },
                "tagPath": "{alarmPath}"
              },
              "overlayOptOut": true,
              "type": "tag"
            }
          }
        },
        "props": {
          "style": {
            "height": "20px",
            "marginBottom": "auto",
            "marginLeft": "-40px",
            "marginRight": "10px",
            "marginTop": "auto",
            "pointerEvents": "none",
            "width": "20px"
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}