{
  "custom": {},
  "params": {
    "filter": ""
  },
  "propConfig": {
    "params.filter": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 450,
      "width": 1199
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "AlarmStatusTable"
            },
            "propConfig": {
              "props.filters.active.text": {
                "binding": {
                  "config": {
                    "path": "view.params.filter"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "columns": {
                "active": {
                  "name": {
                    "enabled": false
                  },
                  "source": {
                    "enabled": false
                  },
                  "state": {
                    "enabled": false
                  }
                }
              },
              "enableDetails": false,
              "filters": {
                "active": {
                  "priorities": {
                    "critical": false,
                    "high": false,
                    "low": false,
                    "medium": false
                  },
                  "states": {
                    "activeAcked": false,
                    "clearUnacked": false
                  }
                }
              },
              "pager": {
                "enabled": false,
                "initialOption": 100
              },
              "responsive": {
                "enabled": true
              },
              "rowStyles": {
                "activeAcked": {
                  "priorities": {
                    "high": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/High/ActiveAcked"
                    },
                    "medium": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/Medium/ActiveAcked",
                      "color": ""
                    }
                  }
                },
                "activeUnacked": {
                  "priorities": {
                    "high": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/High/ActiveUnacked"
                    },
                    "medium": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/Medium/ActiveUnacked",
                      "color": ""
                    }
                  }
                },
                "clearUnacked": {
                  "priorities": {
                    "high": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/High/ClearedUnacked"
                    },
                    "medium": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/Medium/ClearedUnacked",
                      "color": ""
                    }
                  }
                }
              },
              "toolbar": {
                "enableConfiguration": false,
                "enableFilter": false,
                "enableFilterResults": false,
                "enablePreFilters": false
              }
            },
            "type": "ia.display.alarmstatustable"
          },
          {
            "meta": {
              "name": "Dyka_TH"
            },
            "position": {
              "tabIndex": 1
            },
            "props": {
              "columns": {
                "displayPath": {
                  "enabled": true,
                  "order": 1
                },
                "eventId": {
                  "enabled": false
                },
                "eventTime": {
                  "sort": "descending"
                },
                "name": {
                  "enabled": true
                },
                "source": {
                  "enabled": false
                }
              },
              "dateRange": {
                "realtime": {
                  "interval": 24
                }
              },
              "enableDetails": false,
              "name": "Dyka_TH",
              "pager": {
                "enabled": false,
                "initialOption": 100,
                "shelvedPage": 1
              },
              "rowStyles": {
                "acked": {
                  "priorities": {
                    "high": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/High/ActiveAcked"
                    },
                    "medium": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/Medium/ActiveAcked",
                      "color": ""
                    }
                  }
                },
                "active": {
                  "priorities": {
                    "high": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/High/ActiveUnacked"
                    },
                    "medium": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/Medium/ActiveUnacked",
                      "color": ""
                    }
                  }
                },
                "cleared": {
                  "priorities": {
                    "high": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/High/ClearedUnacked"
                    },
                    "medium": {
                      "backgroundColor": "",
                      "classes": "ATA/AlarmRows/Medium/ClearedUnacked",
                      "color": ""
                    }
                  }
                }
              },
              "toolbar": {
                "enabled": false
              }
            },
            "type": "ia.display.alarmjournaltable"
          }
        ],
        "meta": {
          "name": "TabContainer_0"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.currentTabIndex": {
            "binding": {
              "config": {
                "expression": "0"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "contentStyle": {
            "backgroundColor": "--backgroundSecondary"
          },
          "menuStyle": {
            "backgroundColor": ""
          },
          "menuType": "modern",
          "tabSize": {
            "width": 120
          },
          "tabs": [
            {
              "disabled": false,
              "text": "Active"
            },
            {
              "disabled": false,
              "text": "History"
            }
          ]
        },
        "type": "ia.container.tab"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"ToggleAlarmDisplay\")\n\tsystem.perspective.closePopup(\u0027\u0027)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "35px"
        },
        "props": {
          "path": "material/close",
          "style": {
            "cursor": "pointer",
            "marginBottom": "auto",
            "marginLeft": "-35px",
            "zIndex": 1
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex"
  }
}