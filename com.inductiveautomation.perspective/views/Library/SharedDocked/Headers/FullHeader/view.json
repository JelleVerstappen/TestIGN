{
  "custom": {},
  "params": {
    "navigationDataTagPath": "[default]system/Navigation/Navigation data",
    "selectedLine": null
  },
  "propConfig": {
    "params.navigationDataTagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selectedLine": {
      "binding": {
        "config": {
          "path": "page.props.path"
        },
        "transforms": [
          {
            "code": "\treturn None if \"Assets\" not in value else value.split(\"/\")[-1]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 80,
      "width": 1280
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\n\tsystem.perspective.toggleDock(\u0027SideNav\u0027)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "35px",
          "shrink": 0
        },
        "props": {
          "color": "--textThr",
          "path": "material/menu",
          "style": {
            "classes": "form-icon-button"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tsystem.perspective.navigate(\u0027/\u0027)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "DykaLogo"
        },
        "position": {
          "basis": "100px",
          "shrink": 0
        },
        "props": {
          "fit": {
            "mode": "contain"
          },
          "source": "data:image/jpeg;base64,",
          "style": {
            "classes": "form-icon-button",
            "marginBottom": "auto",
            "marginLeft": 5,
            "marginTop": "auto",
            "paddingTop": 3
          }
        },
        "type": "ia.display.image"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Label"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "fallbackDelay": 2.5,
                        "mode": "indirect",
                        "references": {
                          "selectedLine": "{view.params.selectedLine}"
                        },
                        "tagPath": "[NLSTWDYK]Dyka/STW/EXT/{selectedLine}/MESData/LineStatus"
                      },
                      "type": "tag"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "ATA/Components/Labels/TextSmall",
                    "color": "--textThr"
                  },
                  "textStyle": {
                    "textAlign": "right"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Icon"
                },
                "position": {
                  "basis": "30px",
                  "display": false
                },
                "props": {
                  "color": "white",
                  "path": "material/play_arrow"
                },
                "type": "ia.display.icon"
              }
            ],
            "meta": {
              "name": "FlexContainer"
            },
            "position": {
              "basis": "20px",
              "grow": 1
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Label_1"
            },
            "position": {
              "basis": "20px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "selectedLine": "{view.params.selectedLine}"
                    },
                    "tagPath": "[NLSTWDYK]Dyka/STW/EXT/{selectedLine}/MESData/CurrentOrderData/Product"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "ATA/Components/Labels/TextSmall",
                "color": "--textThr"
              },
              "textStyle": {
                "textAlign": "left"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "120px",
          "shrink": 0
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "view.params.selectedLine"
              },
              "transforms": [
                {
                  "code": "\treturn True if str(value).strip() not in [\"\", \"None\"] else False",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "marginLeft": 25
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Label_0"
        },
        "position": {
          "basis": "300px",
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "selectedLine": "{view.params.selectedLine}",
                  "title": "{page.props.title}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tpath \u003d self.page.props.path\n\t\n\tif value.title \u003d\u003d \u0027Control_Room\u0027:\n\t\treturn \u0027Title\u0027\n\telif \"Assets\" in path:\n\t\treturn \"Lijn %s - %s\" % (value.selectedLine, value.title)\n\telse:\n\t\treturn value.title",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Components/Labels/Title",
            "color": "--textThr"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Label"
                },
                "position": {
                  "grow": 1
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "fallbackDelay": 2.5,
                        "mode": "indirect",
                        "references": {
                          "selectedLine": "{view.params.selectedLine}"
                        },
                        "tagPath": "[NLSTWDYK]Dyka/STW/EXT/{selectedLine}/MESData/CurrentOrderData/OrderNumber"
                      },
                      "transforms": [
                        {
                          "code": "\treturn \u0027Order: \u0027 + str(value)",
                          "type": "script"
                        }
                      ],
                      "type": "tag"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "ATA/Components/Labels/TextSmall",
                    "color": "--textThr"
                  },
                  "textStyle": {
                    "textAlign": "left"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "FlexContainer"
            },
            "position": {
              "basis": "20px",
              "grow": 1
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Label_1"
            },
            "position": {
              "basis": "20px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\u0027XX\u0027 + \u0027 / \u0027 + tag(\u0027[NLSTWDYK]Dyka/STW/EXT/\u0027 + {view.params.selectedLine} +\u0027/MESData/CurrentOrderData/RequiredAmount\u0027)"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "ATA/Components/Labels/TextSmall",
                "color": "--textThr"
              },
              "textStyle": {
                "textAlign": "left"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer_1"
        },
        "position": {
          "basis": "120px",
          "shrink": 0
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "view.params.selectedLine"
              },
              "transforms": [
                {
                  "code": "\treturn True if str(value).strip() not in [\"\", \"None\"] else False",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "marginLeft": 25
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "meta": {
                      "name": "Icon"
                    },
                    "position": {
                      "basis": "20px"
                    },
                    "props": {
                      "color": "--textThr",
                      "path": "material/person"
                    },
                    "type": "ia.display.icon"
                  },
                  {
                    "meta": {
                      "name": "Label_0"
                    },
                    "position": {
                      "grow": 1
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": {
                            "path": "session.props.auth.user.userName"
                          },
                          "type": "property"
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "classes": "ATA/Components/Labels/TextSmall",
                        "color": "--textThr",
                        "marginLeft": 5
                      }
                    },
                    "type": "ia.display.label"
                  }
                ],
                "meta": {
                  "name": "FlexContainer_1"
                },
                "position": {
                  "basis": "15px",
                  "grow": 1,
                  "shrink": 0
                },
                "props": {
                  "alignItems": "center",
                  "style": {
                    "marginBottom": 1,
                    "overflow": "visible"
                  }
                },
                "type": "ia.container.flex"
              },
              {
                "children": [
                  {
                    "meta": {
                      "name": "Icon"
                    },
                    "position": {
                      "basis": "20px"
                    },
                    "props": {
                      "color": "--textThr",
                      "path": "material/access_time"
                    },
                    "type": "ia.display.icon"
                  },
                  {
                    "meta": {
                      "name": "Label_0"
                    },
                    "position": {
                      "grow": 1
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": {
                            "expression": "now()"
                          },
                          "transforms": [
                            {
                              "code": "\treturn system.date.format(value,\u0027dd-MM-YYYY HH:mm\u0027)",
                              "type": "script"
                            }
                          ],
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "classes": "ATA/Components/Labels/TextSmall",
                        "color": "--textThr",
                        "marginLeft": 5
                      }
                    },
                    "type": "ia.display.label"
                  }
                ],
                "meta": {
                  "name": "FlexContainer_2"
                },
                "position": {
                  "basis": "15px",
                  "grow": 1,
                  "shrink": 0
                },
                "props": {
                  "alignItems": "center",
                  "style": {
                    "marginTop": 1,
                    "overflow": "visible"
                  }
                },
                "type": "ia.container.flex"
              }
            ],
            "meta": {
              "name": "FlexContainer_0"
            },
            "position": {
              "basis": "160px",
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {},
                  "scope": "C",
                  "type": "logout"
                }
              }
            },
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "35px",
              "shrink": 0
            },
            "props": {
              "color": "--textThr",
              "path": "material/login",
              "style": {
                "classes": "form-icon-button",
                "marginRIght": 5
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "FlexContainer_0"
        },
        "position": {
          "basis": "195px",
          "shrink": 0
        },
        "props": {
          "style": {
            "marginLeft": "auto",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "custom.security": {
        "binding": {
          "config": {
            "path": "page.props.path"
          },
          "transforms": [
            {
              "code": "\ttry:\n\t\tif \"it/security\" not in self.page.props.path:\n\t\t\tpath \u003d \"Security/getPageRights\"\t\t\n\t\t\tparameters \u003d {\"userSource\":self.session.props.auth.idp,\"username\":self.session.props.auth.user.userName,\"url\":self.page.props.path}\n\t\t\tdata \u003d system.db.runNamedQuery(path,parameters\u003dparameters)\n\t\t\tif len(data):\n\t\t\t\tsecurityData \u003d data[0]\n\t\t\t\tself.session.custom.security \u003d securityData\n\t\t\t\tif securityData[\u0027ReadAllowed\u0027] \u003d\u003d False:\n\t\t\t\t\tsystem.perspective.navigate(\"/\")\n\t\t\telse:\n\t\t\t\tself.session.custom.security \u003d {\n\t\t\t\t    \"navigation_path\": \"/\",\n\t\t\t\t    \"CreateAllowed\": False,\n\t\t\t\t    \"ReadAllowed\": False,\n\t\t\t\t    \"UpdateAllowed\": False,\n\t\t\t\t    \"DeleteAllowed\": False\n\t\t\t\t  }\n\t\t\t\tsystem.perspective.navigate(\"/\")\n\t\t\treturn True\n\t\telse:\n\t\t\treturn True\n\t\t\n\texcept:\n\t\treturn False\n\t\t\t\n\t",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "style": {
        "backgroundColor": "var(--prim)",
        "overflow": "hidden",
        "paddingBottom": 2,
        "paddingLeft": 5,
        "paddingRight": 8,
        "paddingTop": 2
      }
    },
    "type": "ia.container.flex"
  }
}