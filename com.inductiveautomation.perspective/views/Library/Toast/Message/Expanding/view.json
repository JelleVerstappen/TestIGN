{
  "custom": {
    "isExpanded": false
  },
  "params": {
    "backgroundColor": "",
    "content": "",
    "message": "",
    "toastID": ""
  },
  "propConfig": {
    "custom.isExpanded": {
      "persistent": true
    },
    "params.backgroundColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.content": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.message": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.toastID": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.message"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "ATA/Library/Toast/Label"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tself.view.custom.isExpanded \u003d not self.view.custom.isExpanded"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Expand"
            },
            "position": {
              "basis": "40px",
              "shrink": 0
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "config": {
                    "path": "view.custom.isExpanded"
                  },
                  "transforms": [
                    {
                      "fallback": "material/keyboard_arrow_down",
                      "inputType": "scalar",
                      "mappings": [
                        {
                          "input": true,
                          "output": "material/keyboard_arrow_up"
                        }
                      ],
                      "outputType": "scalar",
                      "type": "map"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "ATA/Library/Toast/Icon",
                "height": 40,
                "width": 40
              }
            },
            "type": "ia.display.icon"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tfrom ata.toast.handler import session\n\tsession.closeToast(self.view.params.toastID)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Close"
            },
            "position": {
              "basis": "40px",
              "shrink": 0
            },
            "props": {
              "path": "material/close",
              "style": {
                "classes": "ATA/Library/Toast/Icon",
                "height": 40,
                "width": 40
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "Main"
        },
        "position": {
          "shrink": 0
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Markdown"
            },
            "propConfig": {
              "props.source": {
                "binding": {
                  "config": {
                    "expression": "\"\u003cHTML\u003e\"+ {view.params.content}\r\n"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "markdown": {
                "escapeHtml": false
              },
              "style": {
                "fontSize": 12
              }
            },
            "type": "ia.display.markdown"
          }
        ],
        "meta": {
          "name": "Expansion"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.isExpanded"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "ATA/Library/Toast/Expansion"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.params.backgroundColor"
          },
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "ATA/Library/Toast/Root",
        "overflow": "visible",
        "zIndex": 1
      }
    },
    "type": "ia.container.flex"
  }
}