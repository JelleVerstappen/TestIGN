{
  "custom": {},
  "params": {
    "backgroundColor": "",
    "message": "",
    "toastID": ""
  },
  "propConfig": {
    "params.backgroundColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.message": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.toastID": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.message"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "ATA/Library/Toast/Label"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tfrom ata.toast.handler import session\n\tsession.closeToast(self.view.params.toastID)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Close"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "path": "material/close",
          "style": {
            "classes": "ATA/Library/Toast/Icon",
            "height": 40,
            "width": 40
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.params.backgroundColor"
          },
          "type": "property"
        }
      }
    },
    "props": {
      "style": {
        "classes": "ATA/Library/Toast/Root",
        "overflow": "visible",
        "zIndex": 1
      }
    },
    "type": "ia.container.flex"
  }
}