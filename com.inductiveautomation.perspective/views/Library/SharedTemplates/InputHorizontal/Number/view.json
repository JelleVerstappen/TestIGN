{
  "custom": {},
  "params": {
    "enabled": true,
    "engUnits": "",
    "format": "0,0.##",
    "key": "value",
    "maxValue": 10000000,
    "minValue": 0,
    "placeholder": "",
    "unitVisable": true,
    "value": null
  },
  "propConfig": {
    "params.enabled": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.engUnits": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.format": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.key": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.maxValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.minValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.placeholder": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.unitVisable": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 25,
      "width": 454
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.key"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Components/Labels/TextNormal"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "NumericEntryField"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.params.enabled"
                  },
                  "type": "property"
                }
              },
              "props.format": {
                "binding": {
                  "config": {
                    "path": "view.params.format"
                  },
                  "type": "property"
                }
              },
              "props.inputBounds.maximum": {
                "binding": {
                  "config": {
                    "path": "view.params.maxValue"
                  },
                  "type": "property"
                }
              },
              "props.inputBounds.minimum": {
                "binding": {
                  "config": {
                    "path": "view.params.minValue"
                  },
                  "type": "property"
                }
              },
              "props.placeholder": {
                "binding": {
                  "config": {
                    "expression": "translate({view.params.placeholder})"
                  },
                  "type": "expr"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.params.value"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "inputBounds": {},
              "spinner": {
                "enabled": false
              },
              "style": {
                "classes": "ATA/Components/Labels/TextNormal",
                "marginBottom": 5,
                "marginLeft": 5,
                "marginRight": 5,
                "marginTop": 5
              }
            },
            "type": "ia.input.numeric-entry-field"
          },
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "40px",
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.params.unitVisable"
                  },
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.engUnits"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "ATA/Components/Labels/TextSmall"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "props": {
          "style": {
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "#FFFFFF00",
        "overflow": "hidden",
        "paddingLeft": 5
      }
    },
    "type": "ia.container.flex"
  }
}