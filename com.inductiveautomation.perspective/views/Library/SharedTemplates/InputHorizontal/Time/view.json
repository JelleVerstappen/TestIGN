            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "transforms": [
                {
                  "code": "\tif value is not None and value.strip() !\u003d \"\":\n\t\treturn int(value.split(\":\")[0])\n\telse:\n\t\treturn 0",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
