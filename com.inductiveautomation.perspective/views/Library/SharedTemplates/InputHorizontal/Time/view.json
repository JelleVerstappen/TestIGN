          "custom.value": {
            "onChange": {
              "enabled": null,
              "script": "\thInt \u003d currentValue.value[\"hour\"].value\n\tmInt \u003d currentValue.value[\"minute\"].value\n\tsInt \u003d currentValue.value[\"second\"].value\n\t\n\t\n\tif hInt is not None and mInt is not None and sInt is not None:\n\t\thStr \u003d \"%02d\" % hInt\n\t\tmStr \u003d \"%02d\" % mInt\n\t\tsStr \u003d \"%02d\" % sInt\n\t\t\n\t\tself.view.params.value \u003d hStr + \":\" + mStr + \":\" + sStr\n\t\treturn\n\telse:\n\t\treturn"
            }
          },
