{
  "custom": {},
  "params": {
    "allowTriState": false,
    "checkBoxLeft": true,
    "checkIcon": "bootstrap-icons/check-square-fill",
    "enabled": true,
    "key": "value",
    "textPosition": "start",
    "uncheckColor": "",
    "uncheckIcon": "bootstrap-icons/square",
    "value": null
  },
  "propConfig": {
    "params.allowTriState": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.checkBoxLeft": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.checkIcon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.enabled": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.key": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.textPosition": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.uncheckColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.uncheckIcon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 454
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!isnull({view.params.key})"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.key"
              },
              "type": "property"
            }
          },
          "props.textStyle.textAlign": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.textPosition"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Components/Labels/TextNormal"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Checkbox"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "propConfig": {
          "props.checkedIcon.path": {
            "binding": {
              "config": {
                "path": "view.params.checkIcon"
              },
              "type": "property"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "type": "property"
            }
          },
          "props.selected": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.value"
              },
              "type": "property"
            }
          },
          "props.style.marginRight": {
            "binding": {
              "config": {
                "path": "view.params.checkBoxLeft"
              },
              "transforms": [
                {
                  "code": "\treturn \u0027auto\u0027 if value else 0",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.triState": {
            "binding": {
              "config": {
                "path": "view.params.allowTriState"
              },
              "type": "property"
            }
          },
          "props.uncheckedIcon.color.disabled": {
            "binding": {
              "config": {
                "path": "view.params.uncheckColor"
              },
              "type": "property"
            }
          },
          "props.uncheckedIcon.color.enabled": {
            "binding": {
              "config": {
                "path": "view.params.uncheckColor"
              },
              "type": "property"
            }
          },
          "props.uncheckedIcon.path": {
            "binding": {
              "config": {
                "path": "view.params.uncheckIcon"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "checkedIcon": {},
          "indeterminateIcon": {
            "path": "bootstrap-icons/dash-square"
          },
          "style": {
            "classes": "ATA/Components/Buttons/Checkbox",
            "marginBottom": 5,
            "marginLeft": 5
          },
          "text": "",
          "uncheckedIcon": {
            "color": {}
          }
        },
        "type": "ia.input.checkbox"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#FFFFFF00",
        "overflow": "hidden",
        "paddingLeft": 5
      }
    },
    "type": "ia.container.flex"
  }
}