{
  "custom": {
    "hasAlarm": false,
    "hasWarning": true
  },
  "params": {
    "Actual": 70,
    "High": 70,
    "HighHigh": 80,
    "Low": 37,
    "LowLow": 20,
    "ParamName": "value",
    "Setpoint": 51
  },
  "propConfig": {
    "custom.hasAlarm": {
      "binding": {
        "config": {
          "expression": "if(({view.params.Actual} \u003e\u003d {view.params.HighHigh})\r\n\t|| \r\n\t({view.params.Actual} \u003c\u003d {view.params.LowLow}) \r\n\t,\r\n\tTrue,\r\n\tFalse)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.hasWarning": {
      "binding": {
        "config": {
          "expression": "if((({view.params.Actual} \u003e\u003d {view.params.High}) \u0026\u0026 ({view.params.Actual} \u003c {view.params.HighHigh}))\r\n\t|| \r\n\t(({view.params.Actual} \u003c\u003d {view.params.Low}) \u0026\u0026 ({view.params.Actual} \u003e {view.params.LowLow})) \r\n\t,\r\n\tTrue,\r\n\tFalse)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "params.Actual": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.High": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.HighHigh": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Low": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.LowLow": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.ParamName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Setpoint": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 190,
      "width": 130
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "height": 13,
          "width": "100%"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.ParamName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Components/Labels/TextNormal",
            "fontSize": 12
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "MovingAnalogIndicator"
        },
        "position": {
          "height": 165,
          "width": 84.99,
          "x": 25,
          "y": 12.01
        },
        "propConfig": {
          "props.desiredHigh": {
            "binding": {
              "config": {
                "path": "view.params.High"
              },
              "type": "property"
            }
          },
          "props.desiredLow": {
            "binding": {
              "config": {
                "path": "view.params.Low"
              },
              "type": "property"
            }
          },
          "props.highAlarm": {
            "binding": {
              "config": {
                "path": "view.params.High"
              },
              "type": "property"
            }
          },
          "props.highHighAlarm": {
            "binding": {
              "config": {
                "path": "view.params.HighHigh"
              },
              "type": "property"
            }
          },
          "props.lowAlarm": {
            "binding": {
              "config": {
                "path": "view.params.Low"
              },
              "type": "property"
            }
          },
          "props.lowLowAlarm": {
            "binding": {
              "config": {
                "path": "view.params.LowLow"
              },
              "type": "property"
            }
          },
          "props.maxValue": {
            "binding": {
              "config": {
                "expression": "{view.params.HighHigh} + ({view.params.HighHigh} - {view.params.LowLow}) * 0.15"
              },
              "type": "expr"
            }
          },
          "props.minValue": {
            "binding": {
              "config": {
                "expression": "{view.params.LowLow} - ({view.params.HighHigh} - {view.params.LowLow}) * 0.15"
              },
              "type": "expr"
            }
          },
          "props.processValue": {
            "binding": {
              "config": {
                "path": "view.params.Actual"
              },
              "type": "property"
            }
          },
          "props.setpointValue": {
            "binding": {
              "config": {
                "path": "view.params.Setpoint"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "defaultRangeColor": "--disabled",
          "desiredRangeColor": "--color4",
          "highInterlock": null,
          "inactiveAlarmColor": "--color2",
          "label": {
            "format": "#,##0.0",
            "style": {
              "classes": "ATA/Components/Labels/TextLarge",
              "overflow": "visible",
              "overflowX": "visible",
              "overflowY": "visible"
            }
          },
          "level1AlarmColor": "--alarm",
          "level2AlarmColor": "--warning",
          "lowInterlock": null,
          "reverseIndicator": true,
          "sectionOutline": {
            "color": "#000000",
            "width": 1
          },
          "style": {
            "marginLeft": "auto",
            "marginRight": "auto",
            "overflow": "visible",
            "overflowX": "visible",
            "overflowY": "visible"
          }
        },
        "type": "ia.display.moving-analog-indicator"
      },
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "height": 20.01,
          "width": "auto",
          "x": 84.99
        },
        "propConfig": {
          "position.y": {
            "binding": {
              "config": {
                "struct": {
                  "actual": "{view.params.Actual}",
                  "max": "{../MovingAnalogIndicator.props.maxValue}",
                  "min": "{../MovingAnalogIndicator.props.minValue}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tpercent \u003d (value.actual - value.min) / (value.max - value.min) * 100\n#\treturn percent\n\tif percent \u003c 14:\n\t\treturn 138 - percent * 1.47 if percent \u003e 0 else 142\n\telse:\n\t\treturn 157 - (percent - 14) * 1.47 if percent \u003c 100 else 29",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.Actual"
              },
              "transforms": [
                {
                  "formatType": "numeric",
                  "formatValue": "##0.#",
                  "locale": "nl",
                  "type": "format"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Components/Labels/TextNormal",
            "fontSize": 16
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "height": 25,
          "width": 25,
          "x": 25,
          "y": 15.45
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "{view.custom.hasAlarm} || {view.custom.hasWarning}"
              },
              "type": "expr"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "expression": "if({view.custom.hasAlarm}, \u0027dyka/Alarm1\u0027, \u0027dyka/Warning1\u0027)"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "draggable": true,
            "id": "dataPopup",
            "modal": false,
            "overlayDismiss": false,
            "resizable": true,
            "showCloseIcon": true,
            "type": "open",
            "viewPath": "ControlRoom/Assets/Popups/DataPopup",
            "viewportBound": false
          },
          "scope": "C",
          "type": "popup"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "position": {
      "x": 0,
      "y": 6.5
    },
    "type": "ia.container.coord"
  }
}