{
  "custom": {},
  "params": {
    "ID": "value",
    "key": true,
    "rowNum": 1,
    "value": true
  },
  "propConfig": {
    "params.ID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.key": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.rowNum": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 32,
      "width": 454
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Checkbox"
        },
        "position": {
          "basis": "32px",
          "shrink": 0
        },
        "propConfig": {
          "props.selected": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Components/Buttons/Checkbox"
          },
          "text": ""
        },
        "type": "ia.input.checkbox"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.key"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Components/Labels/TextNormal"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tsystem.perspective.sendMessage(\u0027TemplateWithFilter\u0027, payload\u003d{\u0027rowNum\u0027:self.view.params.rowNum,\u0027value\u0027:self.view.params.value,\u0027ID\u0027:self.view.params.ID})"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "#FFFFFF00",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}