  "propConfig": {
    "params.data": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.templateBasis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.titleGray": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 770
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "backgroundColor": "#FFFFFF00",
                "classes": "ATA/Components/Labels/TextNormall",
                "color": "var(--prim)",
                "marginLeft": 5,
                "marginRight": 30,
                "overflow": "hidden",
                "paddingLeft": 5
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "TextField"
            },
            "position": {
              "basis": "50%"
            },
            "props": {
              "deferUpdates": false,
              "placeholder": "Filter",
              "rejectUpdatesWhileFocused": false,
              "style": {
                "marginLeft": "auto",
                "marginRight": 10
              }
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "32px",
          "shrink": 0
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Repeater"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "custom.ID": {
            "binding": {
              "config": {
                "expression": "now(0)"
              },
              "transforms": [
                {
                  "code": "\timport uuid \n\treturn str(uuid.uuid1())",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          },
          "custom.data": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.data"
              },
              "type": "property"
            }
          },
          "props.elementPosition.basis": {
            "binding": {
              "config": {
                "path": "view.params.templateBasis"
              },
              "type": "property"
            }
          },
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "data": "{this.custom.data}",
                  "filter": "{../Title/TextField.props.text}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tdata \u003d value[\u0027data\u0027]\n\tfir \u003d value[\u0027filter\u0027]\n\trl \u003d []\n\tz \u003d 0\n\tID \u003d self.custom.ID\n\tif data is not None and data !\u003d []:\n\t\tfor x in data:\n\t\t\tx \u003d dict(x)\n\t\t\tx.update({\u0027rowNum\u0027:z})\n\t\t\tx.update({\u0027ID\u0027:ID})\n\t\t\tif fir is None or fir \u003d\u003d \u0027\u0027:\n\t\t\t\trl.append(x)\n\t\t\telif str(fir).lower() in str(x[\u0027key\u0027]).lower():\n\t\t\t\trl.append(x)\n\t\t\tz+\u003d1\n\treturn rl",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "alignContent": "flex-start",
          "elementPosition": {
            "grow": 0,
            "shrink": 0
          },
          "path": "SharedTemplates/ReapeaterWithFilter/Row",
          "useDefaultViewWidth": false,
          "wrap": "wrap"
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "paddingBottom": 5,
        "paddingLeft": 2,
        "paddingRight": 2,
        "paddingTop": 5
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "TemplateWithFilter",
          "pageScope": true,
          "script": "\tif payload[\u0027ID\u0027] \u003d\u003d self.getChild(\"Repeater\").custom.ID:\n\t\tself.getChild(\"Repeater\").custom.data[payload[\u0027rowNum\u0027]].value \u003d payload[\u0027value\u0027]",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}