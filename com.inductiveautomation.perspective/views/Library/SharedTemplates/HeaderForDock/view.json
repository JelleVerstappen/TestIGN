{
  "custom": {},
  "params": {
    "closeDockID": "value",
    "closeIcon": true,
    "massageHandler": null,
    "title": "Profile management"
  },
  "propConfig": {
    "params.closeDockID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.closeIcon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.massageHandler": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 45
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "540px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.title"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Components/Labels/Title",
            "color": "--white",
            "fontSize": "24px",
            "fontWeight": "bolder",
            "paddingLeft": "30px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tcloseDockID \u003d self.view.params.closeDockID\n\tmassageHandler \u003d self.view.params.massageHandler\n\tif massageHandler !\u003d None:\n\t\tsystem.perspective.sendMessage(massageHandler)\n\t\tsystem.perspective.closeDock(closeDockID)\n\telse:\n\t\tsystem.perspective.closeDock(closeDockID)\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.closeIcon"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "material/close",
          "style": {
            "classes": "form-icon-button",
            "marginLeft": "auto",
            "marginRight": "5px"
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "background": "--corporateIdentity1",
        "classes": "ATA/Background/RootDock",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}