  "propConfig": {
    "custom.dataInDataset": {
      "binding": {
        "config": {
          "path": "view.params.dataIn"
        },
        "transforms": [
          {
            "code": "\tif ata.typecheck.dataset(value) \u003d\u003d False:\n\t\treturn ata.datasets.datasetFromJSON(value)\n\telse:\n\t\treturn value\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.nextSequence": {
      "binding": {
        "config": {
          "expression": "if({view.params.selectedRow} \u003d -1,\r\n   -1, // this is the fail case\r\n  if(len({view.custom.dataInDataset}) \u003d {view.params.selectedRow}+1,\r\n  \t-1,\r\n   {view.custom.dataInDataset}[{view.params.selectedRow}+1, \r\n    {view.params.sequenceColumn}]))\r\n"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.previousSequence": {
      "binding": {
        "config": {
          "expression": "if({view.params.selectedRow} \u003d -1,\r\n   -1, // this is the fail case\r\n  if({view.params.selectedRow}-1 \u003d -1,\r\n  \t-1,\r\n   {view.custom.dataInDataset}[{view.params.selectedRow}-1, \r\n    {view.params.sequenceColumn}]))\r\n"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.sequence": {
      "binding": {
        "config": {
          "expression": "if({view.params.selectedRow} \u003d -1,\r\n   -1, // this is the fail case\r\n   {view.custom.dataInDataset}[{view.params.selectedRow}, \r\n    {view.params.sequenceColumn}])\r\n"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.sequenceID": {
      "binding": {
        "config": {
          "expression": "if({view.params.selectedRow} \u003d -1,\r\n   -1, // this is the fail case\r\n   {view.custom.dataInDataset}[{view.params.selectedRow}, \r\n    \u0027SequenceID\u0027])\r\n"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "params.IDColumn": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.changed": {
      "paramDirection": "inout",
      "persistent": true
    },
