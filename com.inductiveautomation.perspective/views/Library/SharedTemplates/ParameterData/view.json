{
  "custom": {
    "Actual": 0,
    "High": 3.4,
    "HighHigh": 3.5,
    "Low": 2.9,
    "LowLow": 2.7,
    "Setpoint": 3.35,
    "Unit": "m/min",
    "hasAlarm": true,
    "hasWarning": false
  },
  "params": {
    "ParamName": "Stroom vacuumpomp 1",
    "startPath": "[NLSTWDYK]Dyka/STW/EXT/E07/EXT/MEXT/Screen/ProcessValues/LineSpeed"
  },
  "propConfig": {
    "custom.Actual": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "startPath": "{view.params.startPath}"
          },
          "tagPath": "{startPath}/ActualValue"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.High": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "startPath": "{view.params.startPath}"
          },
          "tagPath": "{startPath}/Metadata/High"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.HighHigh": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "startPath": "{view.params.startPath}"
          },
          "tagPath": "{startPath}/Metadata/HighHigh"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.Low": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "startPath": "{view.params.startPath}"
          },
          "tagPath": "{startPath}/Metadata/Low"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.LowLow": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "startPath": "{view.params.startPath}"
          },
          "tagPath": "{startPath}/Metadata/LowLow"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.Setpoint": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "startPath": "{view.params.startPath}"
          },
          "tagPath": "{startPath}/Setpoint"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.Unit": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "startPath": "{view.params.startPath}"
          },
          "tagPath": "{startPath}/Metadata/Unit"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.hasAlarm": {
      "binding": {
        "config": {
          "expression": "if(({view.custom.Actual} \u003e {view.custom.HighHigh})\r\n\t|| \r\n\t({view.custom.Actual} \u003c {view.custom.LowLow}) \r\n\t,\r\n\tTrue,\r\n\tFalse)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.hasWarning": {
      "binding": {
        "config": {
          "expression": "if((({view.custom.Actual} \u003e {view.custom.High}) \u0026\u0026 ({view.custom.Actual} \u003c {view.custom.HighHigh}))\r\n\t|| \r\n\t(({view.custom.Actual} \u003c {view.custom.Low}) \u0026\u0026 ({view.custom.Actual} \u003e {view.custom.LowLow})) \r\n\t,\r\n\tTrue,\r\n\tFalse)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "params.ParamName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.startPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 180,
      "width": 123
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "height": 13,
          "width": "100%"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.ParamName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Components/Labels/TextNormal",
            "fontSize": 11.5
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "MovingAnalogIndicator"
        },
        "position": {
          "height": 165,
          "width": 81,
          "x": 20.5,
          "y": 12
        },
        "propConfig": {
          "props.desiredHigh": {
            "binding": {
              "config": {
                "path": "view.custom.High"
              },
              "type": "property"
            }
          },
          "props.desiredLow": {
            "binding": {
              "config": {
                "path": "view.custom.Low"
              },
              "type": "property"
            }
          },
          "props.highAlarm": {
            "binding": {
              "config": {
                "path": "view.custom.High"
              },
              "type": "property"
            }
          },
          "props.highHighAlarm": {
            "binding": {
              "config": {
                "path": "view.custom.HighHigh"
              },
              "type": "property"
            }
          },
          "props.lowAlarm": {
            "binding": {
              "config": {
                "path": "view.custom.Low"
              },
              "type": "property"
            }
          },
          "props.lowLowAlarm": {
            "binding": {
              "config": {
                "path": "view.custom.LowLow"
              },
              "type": "property"
            }
          },
          "props.maxValue": {
            "binding": {
              "config": {
                "expression": "{view.custom.HighHigh} + ({view.custom.HighHigh} - {view.custom.LowLow}) * 0.15"
              },
              "type": "expr"
            }
          },
          "props.minValue": {
            "binding": {
              "config": {
                "expression": "{view.custom.LowLow} - ({view.custom.HighHigh} - {view.custom.LowLow}) * 0.15"
              },
              "type": "expr"
            }
          },
          "props.processValue": {
            "binding": {
              "config": {
                "path": "view.custom.Actual"
              },
              "type": "property"
            }
          },
          "props.setpointValue": {
            "binding": {
              "config": {
                "path": "view.custom.Setpoint"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "defaultRangeColor": "--disabled",
          "desiredRangeColor": "--color4",
          "highInterlock": null,
          "inactiveAlarmColor": "--color2",
          "label": {
            "format": "#,##0.0",
            "style": {
              "classes": "ATA/Components/Labels/TextLarge",
              "overflow": "visible",
              "overflowX": "visible",
              "overflowY": "visible"
            }
          },
          "level1AlarmColor": "--alarm",
          "level2AlarmColor": "--warning",
          "lowInterlock": null,
          "reverseIndicator": true,
          "sectionOutline": {
            "color": "#000000",
            "width": 1
          },
          "style": {
            "marginLeft": "auto",
            "marginRight": "auto",
            "overflow": "visible",
            "overflowX": "visible",
            "overflowY": "visible"
          }
        },
        "type": "ia.display.moving-analog-indicator"
      },
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "height": 20,
          "width": 18,
          "x": 74
        },
        "propConfig": {
          "position.y": {
            "binding": {
              "config": {
                "struct": {
                  "actual": "{view.custom.Actual}",
                  "max": "{../MovingAnalogIndicator.props.maxValue}",
                  "min": "{../MovingAnalogIndicator.props.minValue}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tpercent \u003d (value.actual - value.min) / (value.max - value.min) * 100\n#\treturn percent\n\tif percent \u003c 14:\n\t\treturn 138 - percent * 1.47 if percent \u003e 0 else 142\n\telse:\n\t\treturn 157 - (percent - 14) * 1.47 if percent \u003c 100 else 29",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.Actual"
              },
              "transforms": [
                {
                  "code": "\treturn round(value, 2)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "ATA/Components/Labels/TextNormal",
            "fontSize": 14
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "height": 25,
          "width": 25,
          "x": 25,
          "y": 15.45
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "{view.custom.hasAlarm} || {view.custom.hasWarning}"
              },
              "type": "expr"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "expression": "if({view.custom.hasAlarm}, \u0027dyka/Alarm1\u0027, \u0027dyka/Warning1\u0027)"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Label_0"
        },
        "position": {
          "height": 32,
          "width": 45,
          "y": 139.14
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.Unit"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "ATA/Components/Labels/TextNormal",
            "fontSize": 14,
            "textAlign": "right"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "draggable": true,
            "id": "dataPopup",
            "modal": false,
            "overlayDismiss": false,
            "resizable": true,
            "showCloseIcon": true,
            "type": "open",
            "viewParams": {
              "parameterName": "{view.params.ParamName}",
              "startPath": "{view.params.startPath}"
            },
            "viewPath": "ControlRoom/Assets/Popups/DataPopup",
            "viewportBound": false
          },
          "scope": "C",
          "type": "popup"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "overflowY": "hidden"
      }
    },
    "type": "ia.container.coord"
  }
}