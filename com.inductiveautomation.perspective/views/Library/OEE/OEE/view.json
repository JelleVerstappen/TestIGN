        },
        "transforms": [
          {
            "code": "\tif value[\u0027isLive\u0027]:\n\t\treturn {}\n\t\t\n\telse:\n\t\tintervalStart \u003d value[\u0027intervalStart\u0027]\n\t\tintervalEnd \u003d value[\u0027intervalEnd\u0027]\n\t\tOEEData \u003d {\n\t\t\t\"Availability\": {\n\t\t\t\t\"Availability\": 0.912679,\n\t\t\t\t\"Downtime\": 5000,\n\t\t\t\t\"Target\": 0.85,\n\t\t\t\t\"Breakdown\": {\n\t\t\t\t\t\"data\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\"description\": \"Description\",\n\t\t\t\t\t\t\"stringValue\": \"10%\",\n\t\t\t\t\t\t\"value\": 10\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t},\n\t\t\t\"Quality\": {\n\t\t\t\t\"Quality\": 1,\n\t\t\t\t\"Target\": 1,\n\t\t\t\t\"Breakdown\": {\n\t\t\t\t\t\"data\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\"description\": \"Description\",\n\t\t\t\t\t\t\"stringValue\": \"10%\",\n\t\t\t\t\t\t\"value\": 10\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t},\n\t\t\t\"Performance\": {\n\t\t\t\t\"Performance\": 0.7,\n\t\t\t\t\"Target\": 0.85,\n\t\t\t\t\"Breakdown\": {\n\t\t\t\t\t\"data\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\"description\": \"Description\",\n\t\t\t\t\t\t\"stringValue\": \"10%\",\n\t\t\t\t\t\t\"value\": 10\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t},\n\t\t\t\"OEE\": 0.63880473,\n\t\t\t\"OEETarget\": 0.7225,\n\t\t\t\"Interval\": {\n\t\t\t\"IntervalEnd\": intervalStart,\n\t\t\t\"IntervalStart\": intervalEnd,\n\t\t\t\"TotalTimePassed\": 57269\n\t\t\t}\n\t\t}\n\t\treturn OEEData",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.OEETagData": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
