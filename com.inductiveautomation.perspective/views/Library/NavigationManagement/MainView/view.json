        "propConfig": {
          "custom.navStructure": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "direct",
                "tagPath": "[default]Navigation/Navigation data"
              },
              "transforms": [
                {
                  "code": "\treturn ata.perspective.getNavigationStructure(navigationDataset \u003d value, showAll \u003d True)",
                  "type": "script"
                }
              ],
              "type": "tag"
            }
          },
          "custom.selectedId": {
            "binding": {
              "config": {
                "struct": {
                  "navStructure": "{this.custom.navStructure}",
                  "selectedPath": "{this.custom.selectedPath}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tstringPaths \u003d [\u0027[\u0027+str(pathInt)+\u0027]\u0027 for pathInt in value[\u0027selectedPath\u0027]]\n\tjsonPath \u003d \u0027[\"children\"]\u0027.join(stringPaths)\n\t\n\tchild \u003d None\n\tpythonExecString \u003d \"child \u003d value[\u0027navStructure\u0027]\"+jsonPath+\u0027[\"id\"]\u0027\n\texec(pythonExecString)\n\treturn child",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            },
            "onChange": {
              "enabled": null,
              "script": "\tself.getSibling(\"FlexContainer\").refreshBinding(\u0027custom.eventData\u0027)"
            }
