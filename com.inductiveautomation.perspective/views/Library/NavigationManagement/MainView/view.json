                    "onActionPerformed": {
                      "config": {
                        "script": "\tcurrentDataset \u003d system.tag.readBlocking(\u0027[default]Navigation/Navigation data\u0027)[0].value\n\t\n\tID \u003d self.parent.parent.getChild(\"FlexID\").getChild(\"NumericEntryField\").props.value\n\tLabel \u003d self.parent.parent.getChild(\"FlexLabel\").getChild(\"TextField\").props.text\n\tIcon \u003d self.parent.parent.getChild(\"FlexIcon\").getChild(\"TextField\").props.text\n\tPath \u003d self.parent.parent.getChild(\"FlexPath\").getChild(\"TextField\").props.text\n\tParentID \u003d self.parent.parent.getChild(\"FlexParent\").getChild(\"Dropdown\").props.value\n\tRoles \u003d self.parent.parent.getChild(\"FlexRoles\").getChild(\"TextField\").props.text\n\tExcludeMobile \u003d self.parent.parent.getChild(\"FlexMobile\").getChild(\"Checkbox\").props.selected\n\t\n\tnewRow \u003d [ID, Label, Icon, Path, ParentID, Roles, ExcludeMobile]\n\tnewDataset \u003d system.dataset.addRow(currentDataset, newRow)\n\t\n#\t# Check if ID doesn\u0027t exist yet\n\tfor row in range(currentDataset.getRowCount()):\n\t\tif currentDataset.getValueAt(row, \u0027ID\u0027) \u003d\u003d ID:\n\t\t\tself.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Label\").props.text \u003d \u0027Deze ID bestaat al, probeer een ander ID\u0027\n\t\t\treturn\n\t\n\tif ID \u003d\u003d ParentID:\n\t\tself.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Label\").props.text \u003d \u0027Elementen kunnen geen child van zichzelf zijn\u0027\n\t\treturn\n\tself.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Label\").props.text \u003d \u0027\u0027\n\tsystem.tag.writeBlocking(\u0027[default]Navigation/Navigation data\u0027, newDataset)\n\tself.parent.parent.parent.getChild(\"MenuTree\").refreshBinding(\u0027props.items\u0027)"
                      },
