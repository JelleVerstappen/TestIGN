        "propConfig": {
          "custom.eventData": {
            "binding": {
              "config": {
                "path": "this.custom.eventLabel"
              },
              "transforms": [
                {
                  "code": "\t\tselectedID \u003d self.getSibling(\"MenuTree\").custom.selectedId\n\t\t\n\t\tdataset \u003d system.tag.readBlocking([\u0027[default]Navigation/Navigation data\u0027])[0].value\n\t\tfor row in range(dataset.getRowCount()):\n\t\t\trowData \u003d {}\n\t\t\tdatasetID \u003d dataset.getValueAt(row, \u0027Id\u0027)\n\t\t\tif datasetID \u003d\u003d selectedID:\n\t\t\t\trowData[\u0027ID\u0027] \u003d dataset.getValueAt(row, \u0027Id\u0027)\n\t\t\t\trowData[\u0027Label\u0027] \u003d dataset.getValueAt(row, \u0027label\u0027)\n\t\t\t\trowData[\u0027Icon\u0027] \u003d dataset.getValueAt(row, \u0027Material_icon\u0027)\n\t\t\t\trowData[\u0027Path\u0027] \u003d dataset.getValueAt(row, \u0027navigation_path\u0027)\n\t\t\t\trowData[\u0027ParentID\u0027] \u003d dataset.getValueAt(row, \u0027parent_navigation_item_id\u0027)\n\t\t\t\trowData[\u0027Roles\u0027] \u003d dataset.getValueAt(row, \u0027required_roles\u0027)\n\t\t\t\trowData[\u0027ExcludeMobile\u0027] \u003d dataset.getValueAt(row, \u0027exclude_on_mobile\u0027)\n\t\t\t\tbreak\n\t\t\telse:\n\t\t\t\trowData[\u0027ID\u0027] \u003d 0\n\t\t\t\trowData[\u0027Label\u0027] \u003d \u0027\u0027\n\t\t\t\trowData[\u0027Icon\u0027] \u003d \u0027\u0027\n\t\t\t\trowData[\u0027Path\u0027] \u003d \u0027\u0027\n\t\t\t\trowData[\u0027ParentID\u0027] \u003d 0\n\t\t\t\trowData[\u0027Roles\u0027] \u003d \u0027\u0027\n\t\t\t\trowData[\u0027ExcludeMobile\u0027] \u003d False\n\t\treturn rowData",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "custom.eventLabel": {
            "onChange": {
              "enabled": null,
              "script": "\tself.refreshBinding(\u0027custom.eventData\u0027)"
            }
          },
          "custom.eventTarget": {
            "onChange": {
              "enabled": null,
              "script": "\tself.refreshBinding(\u0027custom.eventData\u0027)"
            }
