                    "onActionPerformed": {
                      "config": {
                        "script": "\tcurrentDataset \u003d system.tag.readBlocking(\u0027[default]Navigation/Navigation data\u0027)[0].value\n\t\n\toldID \u003d self.parent.parent.parent.getChild(\"FlexContainer\").custom.eventData.ID\n\t\n\tnewID \u003d self.parent.parent.getChild(\"FlexID\").getChild(\"NumericEntryField\").props.value\n\tnewLabel \u003d self.parent.parent.getChild(\"FlexLabel\").getChild(\"TextField\").props.text\n\tnewIcon \u003d self.parent.parent.getChild(\"FlexIcon\").getChild(\"TextField\").props.text\n\tnewPath \u003d self.parent.parent.getChild(\"FlexPath\").getChild(\"TextField\").props.text\n\tnewParentID \u003d self.parent.parent.getChild(\"FlexParent\").getChild(\"Dropdown\").props.value\n\tnewRoles \u003d self.parent.parent.getChild(\"FlexRoles\").getChild(\"TextField\").props.text\n\tnewExcludeMobile \u003d self.parent.parent.getChild(\"FlexMobile\").getChild(\"Checkbox\").props.selected\n\t\n\tnewRowData \u003d {\u0027id\u0027: newID, \u0027label\u0027: newLabel, \u0027material_icon\u0027: newIcon, \u0027navigation_Path\u0027: newPath,\n\t\t\t\u0027parent_navigation_item_id\u0027: newParentID, \u0027required_roles\u0027: newRoles, \u0027exclude_on_mobile\u0027: newExcludeMobile}\n\t\n#\t# Get row index\n\trowIndex \u003d -1\n\tfor row in range(currentDataset.getRowCount()):\n\t\tif currentDataset.getValueAt(row, \u0027ID\u0027) \u003d\u003d oldID:\n\t\t\trowIndex \u003d row\n\t\t\tbreak\n\t\tif currentDataset.getValueAt(row, \u0027ID\u0027) \u003d\u003d newID:\n\t\t\tself.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Label\").props.text \u003d \u0027Deze ID bestaat al, probeer een ander ID\u0027\n\t\t\treturn\n\t\n\tif rowIndex \u003d\u003d -1:\n\t\tself.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Label\").props.text \u003d \u0027Geselecteerde item in de menu tree is niet gevonden\u0027\n\t\treturn\n\telif newID \u003d\u003d newParentID:\n\t\tself.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Label\").props.text \u003d \u0027Elementen kunnen geen child van zichzelf zijn\u0027\n\t\treturn\n\telse:\n\t\tself.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Label\").props.text \u003d \u0027\u0027\n\t\n\tsystem.perspective.print(rowIndex)\n\tsystem.perspective.print(newRowData)\n\tnewDataset \u003d system.dataset.updateRow(currentDataset, rowIndex, newRowData)\n\tsystem.tag.writeBlocking(\u0027[default]Navigation/Navigation data\u0027, newDataset)\n\tself.parent.parent.parent.getChild(\"MenuTree\").refreshBinding(\u0027props.items\u0027)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
