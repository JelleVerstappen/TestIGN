    "scripts": {
      "customMethods": [
        {
          "name": "new",
          "params": [],
          "script": "\tfunction \u003d \"new\"\n\tfunctionInformation \u003d self.view.custom.functionInformation\n\t\n\tdata \u003d {\n\t  functionInformation[\"columnID\"]: -1,\n\t  \"Description\": \"\",\n\t  \"Created\": \"\",\n\t  \"Modified\": \"\",\n\t  \"ModifiedBy\": \"\"\n\t}\n\t\n\tparams \u003d {\"function\":function,\"data\":data,\"functionInformation\":functionInformation}\n\tsystem.perspective.openDock(\"masterData\", params\u003dparams)"
        },
        {
          "name": "edit",
          "params": [],
          "script": "\tfunction \u003d \"edit\"\n\tdata \u003d self.getChild(\"Table\").props.selection.data[0]\n\tfunctionInformation \u003d self.view.custom.functionInformation\n\tparams \u003d {\"function\":function,\"data\":data,\"functionInformation\":functionInformation}\n\tsystem.perspective.openDock(\"masterData\", params\u003dparams)"
        },
        {
          "name": "delete",
          "params": [],
          "script": "\tfunctionInformation \u003d self.view.custom.functionInformation\n\tcolumnID \u003d functionInformation[\"columnID\"]\n\ttableName \u003d functionInformation[\"tableName\"]\n\t\n\tdata \u003d self.getChild(\"Table\").props.selection.data[0]\n\tID \u003d data[columnID]\n\t\n\tmodifiedBy \u003d self.session.props.auth.user.userName\n\t\n\tquery \u003d \"Update {tableName} set Active \u003d 0, Modified \u003d GETDATE(), ModifiedBy \u003d ? where {columnID} \u003d ?\".format(tableName\u003dtableName,columnID\u003dcolumnID)\n\targs \u003d [modifiedBy,ID]\n\tsystem.db.runPrepUpdate(query, args)\n\tself.getChild(\"Table\").refreshBinding(\u0027props.data\u0027)"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "refresh",
          "pageScope": true,
          "script": "\tself.getChild(\"Table\").refreshBinding(\u0027props.data\u0027)",
          "sessionScope": true,
          "viewScope": true
        }
