{
  "custom": {},
  "params": {
    "MaxValue": 100,
    "Value": 20
  },
  "propConfig": {
    "params.MaxValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "CylindricalTank"
        },
        "position": {
          "height": "100%",
          "width": "100%"
        },
        "propConfig": {
          "props.capacity": {
            "binding": {
              "config": {
                "path": "view.params.MaxValue"
              },
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "expression": "{view.params.Value}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "liquidColor": "#1E90FF",
          "liquidOpacity": 0.9,
          "liquidWarningColor": "#FF4500",
          "strokeWidth": 3,
          "tankColor": "#e0e8f8",
          "tankWarningColor": "#FFE4E1",
          "valueDisplay": {
            "enabled": false
          },
          "warningThreshold": 200
        },
        "type": "ia.display.cylindrical-tank"
      },
      {
        "meta": {
          "name": "Label_0"
        },
        "position": {
          "height": "auto",
          "width": "15%",
          "x": "42.5%",
          "y": "5%"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.MaxValue}-{view.params.Value}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "textStyle": {
            "backgroundColor": "#d3d3d3",
            "borderStyle": "solid",
            "borderWidth": 1,
            "classes": "ATA/Components/Labels/TextLarge",
            "color": "--text",
            "fontSize": "1.5vw",
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label_1"
        },
        "position": {
          "height": "auto",
          "width": "15%",
          "x": "42.5%",
          "y": "85%"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.Value}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "textStyle": {
            "backgroundColor": "#d3d3d3",
            "borderStyle": "solid",
            "borderWidth": 1,
            "classes": "ATA/Components/Labels/TextLarge",
            "color": "--text",
            "fontSize": "1.5vw",
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "type": "ia.container.coord"
  }
}