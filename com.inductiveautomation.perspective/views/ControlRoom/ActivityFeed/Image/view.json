{
  "custom": {},
  "params": {
    "CommentID": "value",
    "Title": "value"
  },
  "propConfig": {
    "params.CommentID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 600,
      "width": 450
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.Title"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "ATA/Components/Labels/TextLarge",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Image"
        },
        "position": {
          "basis": "100px",
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "parameters": {
                  "commentID": "{view.params.CommentID}"
                },
                "queryPath": "ActivityFeed/GetImage",
                "returnFormat": "scalar"
              },
              "transforms": [
                {
                  "expression": "tostring({value},null)",
                  "type": "expression"
                },
                {
                  "code": "\tb64Image \u003d \u0027data:image/jpeg;base64,%s\u0027%value\n\treturn b64Image",
                  "type": "script"
                }
              ],
              "type": "query"
            }
          }
        },
        "props": {
          "fit": {
            "mode": "contain"
          }
        },
        "type": "ia.display.image"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}