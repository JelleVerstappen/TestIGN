                "marginLeft": 15
              },
              "text": ""
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": [
                  {
                    "config": {
                      "script": "\tlineID \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"EmbeddedView\").props.params.value\n\tarticle \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"EmbeddedView_1\").props.params.value\n\tcomment \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"EmbeddedView_0\").props.params.value\n\tarticleRequired \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"EmbeddedView_2\").props.params.value\n\tusername \u003d self.session.props.auth.user.userName\n\t\n\tif articleRequired \u003d\u003d False:\n\t\tarticle \u003d None\n\t\n\tinsertQuery \u003d \u0027\u0027\u0027insert into \n\t\t\t\t\t\tAFComments\n\t\t\t\t\t\t([LineID]\n\t\t\t\t\t\t,[Comment]\n\t\t\t\t\t\t,[CreatedBy]\n\t\t\t\t\t\t,[CreationDate]\n\t\t\t\t\t\t,[StatusID]\n\t\t\t\t\t\t,[Article])\n\t\t\t\t\tvalues\n\t\t\t\t\t\t(?\n\t\t\t\t\t\t,?\n\t\t\t\t\t\t,?\n\t\t\t\t\t\t,?\n\t\t\t\t\t\t,?\n\t\t\t\t\t\t,?)\u0027\u0027\u0027\n\tinsertArgs \u003d [lineID, comment, username, system.date.now(), 1, article]\n\tsystem.db.runPrepUpdate(insertQuery, insertArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\n\tself.parent.parent.getChild(\"FlexContainer\").getChild(\"EmbeddedView\").props.params.value \u003d None\n\tself.parent.parent.getChild(\"FlexContainer\").getChild(\"EmbeddedView_1\").props.params.value \u003d None\n\tself.parent.parent.getChild(\"FlexContainer\").getChild(\"EmbeddedView_0\").props.params.value \u003d None\n\tself.parent.parent.getChild(\"FlexContainer\").getChild(\"EmbeddedView_2\").props.params.value \u003d False\n\t\n\tsystem.perspective.sendMessage(\u0027refreshActivityFeed\u0027)\n\t\n\tsystem.perspective.closeDock(self.parent.parent.getChild(\"Header\").props.params.closeDockID)"
                    },
                    "scope": "G",
                    "type": "script"
                  },
                  {
                    "config": {
                      "id": "{/root/Header.props.params.closeDockID}",
                      "type": "open"
                    },
                    "enabled": false,
                    "scope": "C",
                    "type": "dock"
                  }
                ]
              }
            },
            "meta": {
              "name": "Button_1"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/save_alt"
                }
              },
              "style": {
                "classes": "ATA/Components/Buttons/CTA",
                "marginLeft": 15
              },
              "text": ""
