          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tnewEntry \u003d self.view.params.newEntry\n\tsawListID \u003d self.view.params.sawListID\n\t\n\tdescription \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"TubeType\").props.params.value\n\tBPAmount \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"BPAmount\").props.params.value\n\tBPLength \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"BPLength\").props.params.value\n\tShrinkAmount \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"ShrinkAmount\").props.params.value\n\tShrinkLength \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"ShrinkLength\").props.params.value\n\tDCAmount \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"DCAmount\").props.params.value\n\tDCLength \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"DCLength\").props.params.value\n\tHitsAmount \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"HitsAmount\").props.params.value\n\tHitsLength \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"HitsLength\").props.params.value\n\t\n\tjsonStruct \u003d {\n\t\t\t\t\"BurstPressure\": {\"Amount\": BPAmount, \"Length\": BPLength},\n\t\t\t\t\"Shrink\": {\"Amount\": ShrinkAmount, \"Length\": ShrinkLength},\n\t\t\t\t\"Dichloormethane\": {\"Amount\": DCAmount, \"Length\": DCLength},\n\t\t\t\t\"Hits\": {\"Amount\": HitsAmount, \"Length\": HitsLength}\n\t\t\t}\n\tjsonString \u003d system.util.jsonEncode(jsonStruct)\n\t\n\tif newEntry:\n\t\tinsertQuery \u003d \u0027\u0027\u0027DECLARE @json nvarchar(max) \u003d (SELECT config FROM QASawList WHERE active \u003d 1); \n\t\t\t\t\t\tDECLARE @key  nvarchar(100) \u003d ?;\n\t\t\t\t\t\tDECLARE @edited nvarchar(max) \u003d ?;\n\t\t\t\t\t\t\n\t\t\t\t\t\tDECLARE @nextId int;\n\t\t\t\t\t\t\n\t\t\t\t\t\tSELECT @nextId \u003d\n\t\t\t\t\t\t    ISNULL(MAX(TRY_CAST(j.id AS int)), 0) + 1\n\t\t\t\t\t\tFROM OPENJSON(@json)\n\t\t\t\t\t\tWITH (id int \u0027$.id\u0027) AS j;\n\t\t\t\t\t\t\n\t\t\t\t\t\tDECLARE @newObject nvarchar(max) \u003d\n\t\t\t\t\t\t    N\u0027{\"id\":\u0027 + CAST(@nextId as nvarchar(20)) +\n\t\t\t\t\t\t    N\u0027,\"data\":\u0027 + @edited + N\u0027}\u0027;\n\t\t\t\t\t\t\n\t\t\t\t\t\tSET @json \u003d JSON_MODIFY(\n\t\t\t\t\t\t    @json,\n\t\t\t\t\t\t    \u0027$.\"\u0027 + STRING_ESCAPE(@key, \u0027json\u0027) + \u0027\"\u0027,\n\t\t\t\t\t\t    JSON_QUERY(@newObject)\n\t\t\t\t\t\t);\n\t\t\t\t\t\t\n\t\t\t\t\t\tUPDATE QASawList\n\t\t\t\t\t\tSET config \u003d @json\u0027\u0027\u0027\n\t\tinsertArgs \u003d [description, jsonString]\n\t\tsystem.db.runPrepUpdate(insertQuery, insertArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\n\telse:\n\t\tupdateQuery \u003d \u0027\u0027\u0027DECLARE @json nvarchar(max) \u003d (select config from QASawList where active \u003d 1);\n\t\t\t\t\t\tDECLARE @key  nvarchar(100) \u003d ?;\n\t\t\t\t\t\t\n\t\t\t\t\t\tDECLARE @edited nvarchar(max) \u003d ?;\n\t\t\t\t\t\t\n\t\t\t\t\t\tSET @json \u003d JSON_MODIFY(@json, \u0027$.\"\u0027 + STRING_ESCAPE(@key, \u0027json\u0027) + \u0027\".data\u0027, JSON_QUERY(@edited));\n\t\t\t\t\t\t\n\t\t\t\t\t\tupdate QASawList\n\t\t\t\t\t\t    set config \u003d @json\n\t\t\t\t\t\twhere\n\t\t\t\t\t\t    active \u003d 1;\u0027\u0027\u0027\n\t\tupdateArgs \u003d [description, jsonString]\n\t\tsystem.db.runPrepUpdate(updateQuery, updateArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\t\n\tsystem.perspective.sendMessage(\u0027refreshSawList\u0027)\n\tsystem.perspective.closeDock(self.parent.parent.getChild(\"Header\").props.params.closeDockID)"
                  },
