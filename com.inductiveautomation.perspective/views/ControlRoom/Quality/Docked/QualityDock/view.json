          {
            "meta": {
              "name": "FlexRepeater"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "!{view.params.newEntry}"
                  },
                  "type": "expr"
                }
              },
              "props.instances": {
                "binding": {
                  "config": {
                    "struct": {
                      "key": "{view.params.edit}",
                      "testResults": "{view.params.data.testResults}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "code": "\ttestResults \u003d value[\u0027testResults\u0027]\n\tinstances \u003d []\n\t\n\tfor testResult in sorted(testResults.keys()):\n\t\tif testResult in [\u0027PrintOK\u0027, \u0027VisualOK\u0027, \u0027HitsOK\u0027]:\n\t\t\tcontinue\n\t\tinstance \u003d {\n  \t\t\t\"enabled\": bool(self.view.params.edit),\n  \t\t\t\"engUnits\": \"\",\n  \t\t\t\"format\": \"0,0.####\",\n  \t\t\t\"key\": \"value\",\n  \t\t\t\"maxValue\": 100000000,\n  \t\t\t\"minValue\": 0,\n  \t\t\t\"placeholder\": \"\",\n  \t\t\t\"unitVisable\": True,\n  \t\t\t\"value\": \"\",\n  \t\t\t\"rejected\": False,\n  \t\t\t\"highLimit\": 0,\n  \t\t\t\"lowLimit\": 0\n\t\t}\n\t\ttestResultData \u003d testResults[testResult]\n\t\tmeasured \u003d testResultData[\u0027Measured\u0027]\n\t\tresultGood \u003d int(testResultData[\u0027ResultGood\u0027]) if testResultData[\u0027ResultGood\u0027] is not None else testResultData[\u0027ResultGood\u0027]\n\t\tlowLimit \u003d testResultData[\u0027LowLimit\u0027]\n\t\thighLimit \u003d testResultData[\u0027HighLimit\u0027]\n\t\tengUnit \u003d testResultData.get(\u0027EngUnit\u0027, \"\")\n\t\t\n\t\tinstance[\u0027value\u0027] \u003d measured\n\t\tinstance[\u0027lowLimit\u0027] \u003d lowLimit\n\t\tinstance[\u0027highLimit\u0027] \u003d highLimit\n\t\tinstance[\u0027testName\u0027] \u003d testResult\n\t\tinstance[\u0027engUnits\u0027] \u003d engUnit\n\t\ttestName \u003d dyka.quality.testNameMapping[testResult]\n\t\t\n\t\tif resultGood is None or resultGood \u003d\u003d True:\n\t\t\tinstance[\u0027key\u0027] \u003d testName\n\t\telse:\n\t\t\tinstance[\u0027key\u0027] \u003d testName + \u0027 (min. \u0027 + str(lowLimit) + \u0027 max. \u0027 + str(highLimit) + \u0027)\u0027\n\t\t\tinstance[\u0027rejected\u0027] \u003d True\n\t\tinstances.append(instance)\n\treturn instances",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
