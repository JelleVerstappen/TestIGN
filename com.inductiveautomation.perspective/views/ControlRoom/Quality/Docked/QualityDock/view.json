            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tnewEntry \u003d bool(self.view.params.newEntry)\n\t\n\tLineID \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"Line\").props.params.value\n\tArticleID \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"Article\").props.params.value\n\tArticleDescription  \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"ArticleDescription\").props.params.value\n\tTimeOnTube \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"TimeOnTube\").props.params.value\n\tusername \u003d self.session.props.auth.user.userName\n\t# TO DO: deterimine assigned operator on line from BMS\n\tassignedOperator \u003d \u0027Operator A\u0027\n\tproductionDate \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"ProductionDate\").props.params.value\n\t\n\tgetEmptyResultsJSONQuery \u003d \u0027select Checks from QAArticleSpecs where ArticleID \u003d ?\u0027\n\temptyResults \u003d system.util.jsonDecode(system.db.runScalarPrepQuery(getEmptyResultsJSONQuery, args\u003d[ArticleID], database \u003d \u0027NLSTWDYK_DB_PROD\u0027))\n\temptyResultsJSON \u003d system.util.jsonEncode(emptyResults)\n\t\n\tif emptyResultsJSON is None:\n\t\temptyResultsJSON \u003d system.util.jsonEncode({\n\t\t\t\"Diameter\": {\n\t\t\t\t\"Measured\": 0,\n\t\t\t\t\"ResultGood\": None,\n\t\t\t\t\"LowLimit\": 0,\n\t\t\t\t\"Standard\": None,\n\t\t\t\t\"HighLimit\": 9999999,\n\t\t\t\t\"EngUnit\":\"mm\"\n\t\t\t},\n\t\t\t\"MinWallThickness\": {\n\t\t\t\t\"Measured\": 0,\n\t\t\t\t\"ResultGood\": None,\n\t\t\t\t\"LowLimit\": 0,\n\t\t\t\t\"Standard\": None,\n\t\t\t\t\"HighLimit\": 9999999,\n\t\t\t\t\"EngUnit\":\"mm\"\n\t\t\t},\n\t\t\t\"MaxWallThickness\": {\n\t\t\t\t\"Measured\": 0,\n\t\t\t\t\"ResultGood\": None,\n\t\t\t\t\"LowLimit\": 0,\n\t\t\t\t\"Standard\": None,\n\t\t\t\t\"HighLimit\": 9999999,\n\t\t\t\t\"EngUnit\":\"mm\"\n\t\t\t},\n\t\t\t\"Shrink\": {\n\t\t\t\t\"Measured\": 0,\n\t\t\t\t\"ResultGood\": None,\n\t\t\t\t\"LowLimit\": 0,\n\t\t\t\t\"Standard\": None,\n\t\t\t\t\"HighLimit\": 9999999,\n\t\t\t\t\"EngUnit\":\"%\"\n\t\t\t},\n\t\t\t\"HitsOK\": {\n\t\t\t\t\"Measured\": 0,\n\t\t\t\t\"ResultGood\": None,\n\t\t\t\t\"LowLimit\": 1,\n\t\t\t\t\"Standard\": 1,\n\t\t\t\t\"HighLimit\": 1,\n\t\t\t\t\"EngUnit\":None\n\t\t\t},\n\t\t\t\"Height\": {\n\t\t\t\t\"Measured\": 0,\n\t\t\t\t\"ResultGood\": None,\n\t\t\t\t\"LowLimit\": 0,\n\t\t\t\t\"Standard\": None,\n\t\t\t\t\"HighLimit\": 9999999,\n\t\t\t\t\"EngUnit\":\"mm\"\n\t\t\t},\n\t\t\t\"PrintOK\": {\n\t\t\t\t\"Measured\": 0,\n\t\t\t\t\"ResultGood\": None,\n\t\t\t\t\"LowLimit\": 1,\n\t\t\t\t\"Standard\": 1,\n\t\t\t\t\"HighLimit\": 1,\n\t\t\t\t\"EngUnit\":None\n\t\t\t}\n\t\t})\n\t# Create\n\tif newEntry \u003d\u003d True:\n\t\tinsertQuery \u003d \u0027\u0027\u0027INSERT INTO [dbo].[QACheckData]\n\t\t\t\t\t\t\t([Datetime]\n\t\t\t\t\t\t\t,[LineID]\n\t\t\t\t\t\t\t,[ArticleID]\n\t\t\t\t\t\t\t,[ArticleDescription]\n\t\t\t\t\t\t\t,[TimeOnTube]\n\t\t\t\t\t\t\t,[Results]\n\t\t\t\t\t\t\t,[Approved]\n\t\t\t\t\t\t\t,[Inspector]\n\t\t\t\t\t\t\t,[Operator]\n\t\t\t\t\t\t\t,[ProductionDate])\n\t\t\t\t\t\tVALUES\n\t\t\t\t\t\t\t(getdate(),\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?)\n\t\t\t\t\t\t\u0027\u0027\u0027\n\t\targs \u003d [LineID, ArticleID, ArticleDescription, TimeOnTube, emptyResultsJSON, None, username, assignedOperator, productionDate]\n\t\tsystem.db.runPrepUpdate(insertQuery, args, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\n\t# Edit\n\tif newEntry \u003d\u003d False:\n\t\tqualityID \u003d self.view.params.qualityID\n\t\tflexRepeaterInstances \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"FlexRepeater\").props.instances\n\t\tupdateQuery \u003d \u0027\u0027\u0027DECLARE @updates NVARCHAR(MAX) \u003d ?\n\t\t\t\t\t\t\n\t\t\t\t\t\tDECLARE @newJson NVARCHAR(MAX);\n\t\t\t\t\t\t\n\t\t\t\t\t\tSELECT @newJson \u003d results\n\t\t\t\t\t\tFROM QACheckData\n\t\t\t\t\t\tWHERE QualityRecordID \u003d ?;\n\t\t\t\t\t\t\u0027\u0027\u0027\n\t\t\n\t\tupdatesJSON \u003d {}\n\t\t#Add PrintOK, Visual, HitsOK bools if theyre selected\n\t\tboolsList \u003d [\u0027PrintOK\u0027, \u0027VisualOK\u0027, \u0027HitsOK\u0027]\n\t\t\n\t\tapproved \u003d True\n\t\trejectReason \u003d \u0027\u0027\n\t\t# Loop over bool embedded views to create dynamic query\n\t\tfor boolCheck in boolsList:\n\t\t\tif boolCheck not in emptyResultsJSON:\n\t\t\t\tcontinue\n\t\t\ttry:\n\t\t\t\tboolValue \u003d int(self.parent.parent.getChild(\"FlexContainer\").getChild(boolCheck).props.params.value)\n\t\t\texcept:\n\t\t\t\tboolValue \u003d None\n\t\t\t\tapproved \u003d None\n\t\t\t# Determine approved\n\t\t\tif boolValue \u003d\u003d False:\n\t\t\t\tapproved \u003d False\n\t\t\t\trejectReason +\u003d system.util.translate(boolCheck, self.session.props.locale) + \u0027 niet OK.\u0027\n\t\t\tif boolValue is not None:\n\t\t\t\tupdatesJSON[boolCheck] \u003d {\"Measured\": boolValue, \u0027ResultGood\u0027: boolValue, \u0027EngUnit\u0027: None}\n\t\t\t\tupdateQuery +\u003d \"SET @newJson \u003d JSON_MODIFY(@newJson, \u0027$.\" + boolCheck + \".Measured\u0027,  cast(JSON_VALUE(@updates, \u0027$.\" + boolCheck +\".Measured\u0027) as int));\"\n\t\t\t\tupdateQuery +\u003d \"SET @newJson \u003d JSON_MODIFY(@newJson, \u0027$.\" + boolCheck + \".ResultGood\u0027,  cast(JSON_VALUE(@updates, \u0027$.\" + boolCheck +\".ResultGood\u0027) as int));\"\n\t\t\t\tupdateQuery +\u003d \"SET @newJson \u003d JSON_MODIFY(@newJson, \u0027$.\" + boolCheck + \".EngUnit\u0027, cast(JSON_VALUE(@updates, \u0027$.\" + boolCheck +\".ResultGood\u0027) as nvarchar(10)));\"\n\t\t\n\t\t# Loop over flex repeater instances to create dynamic query\n\t\tfor instance in flexRepeaterInstances:\n#\t\t\tinstanceName \u003d instance.key.split(\u0027 (min\u0027)[0]\n\t\t\tinstanceName \u003d instance.testName\n\t\t\ttry:\n\t\t\t\tvalue \u003d float(instance.value)\n\t\t\texcept:\n\t\t\t\tvalue \u003d None\n\t\t\tminValue \u003d float(instance.lowLimit)\n\t\t\tmaxValue \u003d float(instance.highLimit)\n\t\t\t\n\t\t\tif value is not None:\n\t\t\t\tresultGood \u003d 1 if (value \u003e\u003d minValue and value \u003c\u003d maxValue) else 0\n\t\t\t\tengUnit \u003d emptyResults[instanceName][\"EngUnit\"]\n\t\t\t\t# Determine approved\n\t\t\t\tupdatesJSON[instanceName] \u003d {\"Measured\": value, \u0027ResultGood\u0027: resultGood, \"EngUnit\": engUnit}\n\t\t\t\tupdateQuery +\u003d \"SET @newJson \u003d JSON_MODIFY(@newJson, \u0027$.\" + instanceName + \".Measured\u0027,  cast(JSON_VALUE(@updates, \u0027$.\" + instanceName +\".Measured\u0027) as float));\"\n\t\t\t\tupdateQuery +\u003d \"SET @newJson \u003d JSON_MODIFY(@newJson, \u0027$.\" + instanceName + \".ResultGood\u0027,  cast(JSON_VALUE(@updates, \u0027$.\" + instanceName +\".ResultGood\u0027) as int));\"\n\t\t\t\tupdateQuery +\u003d \"SET @newJson \u003d JSON_MODIFY(@newJson, \u0027$.\" + instanceName + \".EngUnit\u0027,  cast(JSON_VALUE(@updates, \u0027$.\" + instanceName +\".EngUnit\u0027) as nvarchar(10)));\"\n\t\t\t\t\n\t\t\t\tif resultGood \u003d\u003d 0:\n\t\t\t\t\tapproved \u003d False\n\t\t\t\t\trejectReason +\u003d system.util.translate(instanceName, self.session.props.locale) + \u0027 niet OK. \u0027\n\t\t\telif value is None and approved !\u003d False:\n\t\t\t\tapproved \u003d None\n\t\t\t\n\t\tupdateQuery +\u003d \u0027\u0027\u0027UPDATE QACheckData\n\t\t\t\t\t\tSET Results \u003d @newJson,\n\t\t\t\t\t\t\tApproved \u003d ?\n\t\t\t\t\t\tWHERE QualityRecordID \u003d ?;\u0027\u0027\u0027\n\t\tupdateArgs \u003d [system.util.jsonEncode(updatesJSON), qualityID, approved, qualityID]\n\t\tsystem.db.runPrepUpdate(updateQuery, updateArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\n\t\tsystem.perspective.print(rejectReason)\n\t\t\n\t\tif len(rejectReason) \u003e 0 and approved \u003d\u003d False:\n\t\t\tarticleNumber \u003d system.db.runScalarPrepQuery(\u0027select articleNumber from articles where articleID \u003d ?\u0027, [ArticleID], database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\t\tdyka.activityFeed.addEntry(\u0027QualityRemark\u0027, {\u0027LineID\u0027: LineID,\u0027Comment\u0027: rejectReason,\u0027Article\u0027: articleNumber,\u0027Datetime\u0027: system.date.now(),\u0027CreatedBy\u0027: username})\n\tsystem.perspective.sendMessage(\u0027refreshQuality\u0027)\n\tsystem.perspective.closeDock(self.parent.parent.getChild(\"Header\").props.params.closeDockID)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Button_1"
