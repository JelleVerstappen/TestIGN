                "marginTop": 10
              },
              "text": "Gelinkt niveau",
              "textStyle": {
                "paddingLeft": 5
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onItemClicked": {
                  "config": {
                    "script": "\tselectionData \u003d self.props.selectionData[0].value\n\t\n\tselectionJSON \u003d {\n\t\t\t  \"NodeID\": selectionData.get(\u0027NodeID\u0027),\n\t\t\t  \"ParameterValueID\": selectionData.get(\u0027ParameterValueID\u0027),\n\t\t\t  \"HighAlarm\": selectionData.get(\u0027HighAlarm\u0027),\n\t\t\t  \"HighWarning\": selectionData.get(\u0027HighWarning\u0027),\n\t\t\t  \"ParamValue\": selectionData.get(\u0027ParamValue\u0027),\n\t\t\t  \"LowAlarm\": selectionData.get(\u0027LowAlarm\u0027),\n\t\t\t  \"LowWarning\": selectionData.get(\u0027LowWarning\u0027),\n\t\t\t  \"ParameterID\": selectionData.get(\u0027ParameterID\u0027),\n\t\t\t  \"ParamName\": selectionData.get(\u0027ParamName\u0027),\n\t\t\t  \"FolderParentID\" : selectionData.get(\u0027ParentID\u0027)\n\t\t\t}\n\t\n\tself.view.getChild(\"root\").custom.selectedTreeData \u003d selectionJSON"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Tree"
            },
            "propConfig": {
              "custom.isFolder": {
                "binding": {
                  "config": {
                    "path": "this.props.selectionData"
                  },
                  "transforms": [
                    {
                      "code": "\tif value \u003d\u003d []:\n\t\treturn None\n\telse:\n\t\tif value[0].value.get(\u0027ParameterID\u0027) is not None:\n\t\t\treturn False\n\t\treturn True",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.items": {
                "binding": {
                  "config": {
                    "queryPath": "Article/ArticleManagement/GetTreeArticles",
                    "returnFormat": "json"
                  },
                  "transforms": [
                    {
                      "code": "\tdata \u003d value\n\timport json\n\t\t# Stap 2: Bouw een dictionary van alle nodes\n\tnodes \u003d {}\n\tlineID \u003d self.getSibling(\"Lijn\").props.params.value\n\tfor row in data:\n\t\tif lineID is not None and lineID !\u003d row[\u0027lineID\u0027]:\n\t\t\tcontinue\n\t\tnodeID \u003d row[\"RecipeElementID\"]\n\t\tparentID \u003d row[\"ParentID\"]\n\t\tparams \u003d []\n\t\tif row[\"ParametersJSON\"]:\n\t\t\t\n\t\t\tparams \u003d json.loads(row[\"ParametersJSON\"])\n\t\t\n\t\t# Elke node: basisstructuur\n\t\tnodes[nodeID] \u003d {\n\t\t\t\"expanded\": False,\n\t\t\t\"data\": {\"NodeID\": nodeID, \"ParentID\": parentID},\n\t\t\t\"label\": row[\"Description\"],\n\t\t\t\"items\": [],  # kinderen komen hier\n\t\t\t\"params\": params\n\t\t}\n\n\t# Stap 3: Bouw de boomstructuur d.m.v. parent-child relatie\n\troot_nodes \u003d []\n\tfor row in data:\n\t\tif lineID is not None and lineID !\u003d row[\u0027lineID\u0027]:\n\t\t\tcontinue\n\t\tnodeID \u003d row[\"RecipeElementID\"]\n\t\tparentID \u003d row[\"ParentID\"]\n\t\tnode \u003d nodes[nodeID]\n\t\t\n\t\tarticleNumber \u003d row[\u0027ArticleNumber\u0027] \n\t\t\n\t\tif articleNumber is not None:\n\t\t\tnode[\"items\"].append({\n\t\t\t\t\"expanded\": False,\n\t\t\t\t\"data\": {\n\t\t\t\t\t\"articleID\": row[\"ArticleID\"],\n\t\t\t\t\t\"NodeID\": nodeID,\n\t\t\t\t},\n\t\t\t\t\"label\": \u0027Artikel \u0027 + str(articleNumber),\n\t\t\t\t\"icon\": {\"path\": \"bootstrap-icons/card-list\"},\n\t\t\t\t\"items\": []\n\t\t\t})\n\t\t\n\t\t# Parameters toevoegen als child items\n\t\tfor p in node[\"params\"]:\n\t\t\tnode[\"items\"].append({\n\t\t\t\t\"expanded\": False,\n\t\t\t\t\"data\": {\n\t\t\t\t\t\"ParamValue\": p[\"Value\"],\n\t\t\t\t\t\"ParamName\": p[\"Description\"],\n\t\t\t\t\t\"HighAlarm\": p[\"HighAlarm\"],\n\t\t\t\t\t\"HighWarning\": p[\"HighWarning\"],\n\t\t\t\t\t\"LowWarning\": p[\"LowWarning\"],\n\t\t\t\t\t\"LowAlarm\": p[\"LowAlarm\"],\n\t\t\t\t\t\"NodeID\": nodeID,\n\t\t\t\t\t\"ParameterID\": p[\"ProcessParameterID\"],\n\t\t\t\t\t\"ParameterValueID\": p[\"ProcessParameterValueID\"]\n\t\t\t\t},\n\t\t\t\t\"label\": \"%s \u003d %s %s\" % (p[\"Description\"], p[\"Value\"], p[\u0027Unit\u0027]),\n\t\t\t\t\"icon\": {\"path\": \"material/stop\"},\n\t\t\t\t\"items\": []\n\t\t\t})\n\n\t\t# Verwijder tijdelijke params\n\t\tdel node[\"params\"]\n\n\t\tif parentID is None:\n\t\t\troot_nodes.append(node)\n\t\telse:\n\t\t\tnodes[parentID][\"items\"].append(node)\n\t\n\tselectionPath \u003d self.props.selection[0]\n\tselectionList \u003d selectionPath.split(\u0027/\u0027)\n\t\n\tfirstLoop \u003d True\n\tif len(selectionList) \u003e 0 and selectionPath !\u003d \u0027\u0027:\n\t\tfor selected in selectionList:\n\t\t\tif firstLoop \u003d\u003d True:\n\t\t\t\troot_nodes[int(selected)][\u0027expanded\u0027] \u003d True\n\t\t\t\tLoopedData \u003d root_nodes[int(selected)][\u0027items\u0027]\n\t\t\t\n\t\t\telse:\n\t\t\t\ttry:\n\t\t\t\t\tLoopedData \u003d LoopedData[int(selected)]\n\t\t\t\texcept:\n\t\t\t\t\ttry:\n\t\t\t\t\t\tLoopedData \u003d LoopedData[0]\n\t\t\t\t\texcept:\n\t\t\t\t\t\tcontinue\n\t\t\t\tLoopedData[\u0027expanded\u0027] \u003d True\n\t\t\t\tLoopedData \u003d LoopedData[\u0027items\u0027]\n\t\t\t\t\n\t\t\tfirstLoop \u003d False\n\t\n\t# Stap 4: Return de boom \n\treturn root_nodes",
                      "type": "script"
                    }
                  ],
                  "type": "query"
                }
              }
            },
            "props": {
              "appearance": {
                "defaultNodeIcons": {
                  "collapsed": {
                    "path": "material/folder"
