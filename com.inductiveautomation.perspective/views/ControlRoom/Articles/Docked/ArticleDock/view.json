                "classes": "ATA/Components/Buttons/Sec",
                "marginLeft": 15
              },
              "text": ""
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tedit \u003d int(self.view.params.edit)\n\t\n\tarticleNumber \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"ArticleNumber\").props.params.value\n\tarticleDescription \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"ArticleDescription\").props.params.value\n\tlinkedNodeID \u003d self.view.getChild(\"root\").custom.selectedTreeData.NodeID\n\tlineID \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"Lijn\").props.params.value\n\ttubeGroup \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"SawListGroup\").props.params.value\n\tarticleID \u003d self.view.params.data.ArticleID\n\t\n\tif edit \u003d\u003d False:\n\t\tinsertQuery \u003d \u0027\u0027\u0027insert into Articles\n\t\t\t\t\t\t\t(ArticleNumber,\n\t\t\t\t\t\t\tArticleDescription,\n\t\t\t\t\t\t\tLinkedNodeID,\n\t\t\t\t\t\t\tLineID,\n\t\t\t\t\t\t\tSawListID)\n\t\t\t\t\t\tvalues\n\t\t\t\t\t\t\t(?,\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?,\n\t\t\t\t\t\t\t?)\n\t\t\t\t\t\t\u0027\u0027\u0027\n\t\tinsertArgs \u003d [articleNumber, articleDescription, linkedNodeID, lineID, tubeGroup]\n\t\tsystem.db.runPrepUpdate(insertQuery, insertArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\t\n\telse:\n\t\tupdateQuery \u003d \u0027\u0027\u0027update Articles\n\t\t\t\t\t\tset\n\t\t\t\t\t\t\tArticleNumber \u003d ?,\n\t\t\t\t\t\t\tArticleDescription \u003d ?,\n\t\t\t\t\t\t\tLinkedNodeID \u003d ?,\n\t\t\t\t\t\t\tLineID \u003d ?,\n\t\t\t\t\t\t\tSawListID \u003d ?\n\t\t\t\t\t\twhere\n\t\t\t\t\t\t\tArticleID \u003d ?\n\t\t\t\t\t\u0027\u0027\u0027\n\t\tupdateArgs \u003d [articleNumber, articleDescription, linkedNodeID, lineID, tubeGroup, articleID]\n\t\tsystem.db.runPrepUpdate(updateQuery, updateArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\t\n\tsystem.perspective.sendMessage(\u0027refreshArticles\u0027)\n\tsystem.perspective.sendMessage(\u0027refreshArticleInfo\u0027)\n\tsystem.perspective.sendMessage(\u0027refreshArticleManagement\u0027)\n\tself.view.getChild(\"root\").resetInput()\n\t\n\tsystem.perspective.closeDock(\u0027ArticleDock\u0027)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Button_1"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/save_alt"
                }
              },
              "style": {
                "classes": "ATA/Components/Buttons/CTA",
                "marginLeft": 15
              },
              "text": ""
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Footer"
        },
        "position": {
          "basis": "45px",
          "shrink": 0
        },
        "props": {
          "justify": "flex-end",
          "style": {
            "backgroundColor": "--backgroundSecondary",
            "borderTopLeftRadius": 5,
            "borderTopRightRadius": 5,
            "padding": 7,
            "zIndex": 1
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "custom.selectedTreeData": {
        "binding": {
          "config": {
            "path": ""
          },
          "transforms": [
            {
              "code": "\tjson \u003d {\n\t\t  \"ParameterValueID\": None,\n\t\t  \"HighAlarm\": None,\n\t\t  \"HighWarning\": None,\n\t\t  \"NodeID\": None,\n\t\t  \"ParamValue\": None,\n\t\t  \"LowAlarm\": None,\n\t\t  \"LowWarning\": None,\n\t\t  \"ParameterID\": None,\n\t\t  \"ParamName\": None\n\t\t}\n\t\n\treturn json",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "ATA/Background/RootDock"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "resetInput",
          "params": [],
          "script": "\t# implement your method here\n\tself.getChild(\"FlexContainer\").getChild(\"ArticleNumber\").props.params.value \u003d \u0027\u0027\n\tself.getChild(\"FlexContainer\").getChild(\"ArticleDescription\").props.params.value \u003d \u0027\u0027\n\tself.getChild(\"FlexContainer\").getChild(\"Lijn\").props.params.value \u003d None\n\tself.getChild(\"FlexContainer\").getChild(\"Tree\").props.selection[0] \u003d \u0027\u0027"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": []
    },
    "type": "ia.container.flex"
  }
}