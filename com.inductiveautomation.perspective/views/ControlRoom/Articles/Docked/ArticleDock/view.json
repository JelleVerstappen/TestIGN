                  "collapsed": {
                    "path": "material/arrow_right"
                  },
                  "expanded": {
                    "path": "material/arrow_drop_down"
                  }
                }
              },
              "selection": [
                "0"
              ],
              "selectionData": [
                {
                  "itemPath": "0",
                  "value": {
                    "NodeID": 1,
                    "ParentID": null
                  }
                }
              ],
              "style": {
                "classes": "ATA/Background/CardSecondary",
                "marginTop": 0
