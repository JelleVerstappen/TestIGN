{
  "custom": {},
  "params": {
    "assetID": "value",
    "lineID": "value"
  },
  "propConfig": {
    "params.assetID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.lineID": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 600
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "params": {
            "closeDockID": "ParameterFilters",
            "closeIcon": true,
            "title": "Filters"
          },
          "path": "Library/SharedTemplates/HeaderForDock",
          "style": {
            "textTransform": "capitalize"
          },
          "useDefaultViewHeight": true
        },
        "type": "ia.display.view"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Line"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.params.options": {
                "binding": {
                  "config": {
                    "queryPath": "getLinesDropdown"
                  },
                  "transforms": [
                    {
                      "code": "\treturn system.dataset.addRow(value, 0, [-1, \u0027Geen filter\u0027])",
                      "type": "script"
                    }
                  ],
                  "type": "query"
                }
              },
              "props.params.value": {
                "binding": {
                  "config": {
                    "path": "view.params.lineID"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "enabled": true,
                "key": "Lijn",
                "marginRight": 5,
                "multiSelect": false,
                "placeholder": "Select...",
                "showClearIcon": false
              },
              "path": "Library/SharedTemplates/Input/Dropdown",
              "useDefaultViewHeight": true
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Asset"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.params.options": {
                "binding": {
                  "config": {
                    "parameters": {
                      "lineID": "{../Line.props.params.value}"
                    },
                    "queryPath": "Article/Parameters/GetAssets"
                  },
                  "transforms": [
                    {
                      "code": "\treturn system.dataset.addRow(value, 0, [-1, \u0027Geen filter\u0027])",
                      "type": "script"
                    }
                  ],
                  "type": "query"
                }
              },
              "props.params.value": {
                "binding": {
                  "config": {
                    "path": "view.params.assetID"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "enabled": true,
                "key": "Lijn onderdeel",
                "marginRight": 5,
                "multiSelect": false,
                "placeholder": "Select...",
                "showClearIcon": false
              },
              "path": "Library/SharedTemplates/Input/Dropdown",
              "useDefaultViewHeight": true
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "backgroundColor": "#FFFFFF",
            "padding": 10
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "id": "{/root/Header.props.params.closeDockID}",
                    "type": "close"
                  },
                  "scope": "C",
                  "type": "dock"
                }
              }
            },
            "meta": {
              "name": "Button_5"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/cancel"
                }
              },
              "style": {
                "classes": "ATA/Components/Buttons/Sec",
                "marginLeft": 15
              },
              "text": ""
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tlineID \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"Line\").props.params.value\n\tassetID \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"Asset\").props.params.value\n\t\n\tpayload \u003d {\u0027lineID\u0027: lineID, \u0027assetID\u0027: assetID}\n\t\n\tsystem.perspective.sendMessage(\u0027applyFiltersParameters\u0027, payload)\n\tsystem.perspective.closeDock(self.parent.parent.getChild(\"Header\").props.params.closeDockID)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Button_6"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/check"
                }
              },
              "style": {
                "classes": "ATA/Components/Buttons/CTA",
                "marginLeft": 15
              },
              "text": ""
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Footer"
        },
        "position": {
          "basis": "45px",
          "shrink": 0
        },
        "props": {
          "justify": "flex-end",
          "style": {
            "backgroundColor": "--backgroundSecondary",
            "borderTopLeftRadius": 5,
            "borderTopRightRadius": 5,
            "padding": 7,
            "zIndex": 1
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}