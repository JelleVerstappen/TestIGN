              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tselectedParameterID \u003d self.view.params.data.parameterID\n\tparamName \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"ParamName\").props.params.value\n\tassetID \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"Asset\").props.params.value\n\tunit \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"Unit\").props.params.value\n\tdefaultValue \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"DefaultSetpoint\").props.params.value\n\tdefaultLowLow \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"DefaultLowLow\").props.params.value\n\tdefaultLow \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"DefaultLow\").props.params.value\n\tdefaultHigh \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"DefaultHigh\").props.params.value\n\tdefaultHighHigh \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"DefaultHighHigh\").props.params.value\n\ttagPath \u003d self.parent.parent.getChild(\"FlexContainer\").getChild(\"CurrentTagPath\").props.params.value\n\tusername \u003d self.session.props.auth.user.userName\n\t\n\tif selectedParameterID is None:\n\t\t# insert new entry\n\t\tinsertQuery \u003d \u0027\u0027\u0027INSERT INTO [dbo].[ProcessParameters]\n\t\t\t\t\t\t\t([AssetID]\n\t\t\t\t\t\t\t,[Description]\n\t\t\t\t\t\t\t,[DefaultValue]\n\t\t\t\t\t\t\t,[DefaultHigh]\n\t\t\t\t\t\t\t,[DefaultLow]\n\t\t\t\t\t\t\t,[DefaultHighHigh]\n\t\t\t\t\t\t\t,[DefaultLowLow]\n\t\t\t\t\t\t\t,[Unit]\n\t\t\t\t\t\t\t,[ModifiedBy]\n\t\t\t\t\t\t\t,[TagPath]\n\t\t\t\t\t\t\t,[Created])\n\t\t\t\t\t\tVALUES\n\t\t\t\t\t\t\t(?\n\t\t\t\t\t\t\t,?\n\t\t\t\t\t\t\t,?\n\t\t\t\t\t\t\t,?\n\t\t\t\t\t\t\t,?\n\t\t\t\t\t\t\t,?\n\t\t\t\t\t\t\t,?\n\t\t\t\t\t\t\t,?\n\t\t\t\t\t\t\t,?\n\t\t\t\t\t\t\t,?\n\t\t\t\t\t\t\t,getdate())\u0027\u0027\u0027\n\t\tinsertArgs \u003d [assetID, paramName, defaultValue, defaultHigh, defaultLow, defaultHighHigh, defaultLowLow, unit, username, tagPath]\n\t\tsystem.db.runPrepUpdate(insertQuery, insertArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\t\n\t\t\n\telse:\n\t\t#update existing\n\t\tupdateQuery \u003d \u0027\u0027\u0027\n\t\t\t\t\tupdate processParameters\n\t\t\t\t\tset\n\t\t\t\t\t\tDescription \u003d ?,\n\t\t\t\t\t\tAssetID \u003d ?,\n\t\t\t\t\t\tDefaultValue \u003d ?,\n\t\t\t\t\t\tDefaultHigh \u003d ?,\n\t\t\t\t\t\tDefaultLow \u003d ?,\n\t\t\t\t\t\tDefaultHighHigh \u003d ?,\n\t\t\t\t\t\tDefaultLowLow \u003d ?,\n\t\t\t\t\t\tUnit \u003d ?,\n\t\t\t\t\t\tModifiedBy \u003d ?,\n\t\t\t\t\t\tTagPath \u003d ?,\n\t\t\t\t\t\tModified \u003d getdate()\n\t\t\t\t\twhere\n\t\t\t\t\t\tProcessParameterID \u003d ?\n\t\t\t\t\t\t\u0027\u0027\u0027\n\t\tupdateArgs \u003d [paramName, assetID, defaultValue, defaultHigh, defaultLow, defaultHighHigh, defaultLowLow, unit, username, tagPath, selectedParameterID]\n\t\tsystem.db.runPrepUpdate(updateQuery, updateArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\n\tsystem.perspective.sendMessage(\u0027refreshParameters\u0027)\n\tself.view.getChild(\"root\").resetInput()\n\tsystem.perspective.closeDock(self.parent.parent.getChild(\"Header\").props.params.closeDockID)"
                  },
                  "scope": "G",
                  "type": "script"
