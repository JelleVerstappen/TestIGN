              "text": ""
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tselectedStepID \u003d self.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Table\").props.selection.data[0].StepID\n\tsequenceNr \u003d self.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Table\").props.selection.data[0].SequenceNumber\n\tprocedureID \u003d self.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Table\").props.selection.data[0].ProcedureID\n\t\n\tdeleteMainStepQuery \u003d \u0027\u0027\u0027update \n\t\t\t\t\t\t\t\tSPMainStepsConfig\n\t\t\t\t\t\t\tset\n\t\t\t\t\t\t\t\tActive \u003d 0\n\t\t\t\t\t\t\twhere\n\t\t\t\t\t\t\t\tStepID \u003d ?\u0027\u0027\u0027\n\tdeleteMainStepArgs \u003d [selectedStepID]\n\tsystem.db.runPrepUpdate(deleteMainStepQuery, deleteMainStepArgs)\n\t\n\tupdateLowerStepsQuery \u003d \u0027\u0027\u0027update\n\t\t\t\t\t\t\tSPMainStepsConfig\n\t\t\t\t\t\tset\n\t\t\t\t\t\t\tSequenceNumber \u003d SequenceNumber - 1\n\t\t\t\t\t\twhere \n\t\t\t\t\t\t\tSequenceNumber \u003e ?\n\t\t\t\t\t\t\tand\n\t\t\t\t\t\t\tProcedureID \u003d ?\u0027\u0027\u0027\n\tupdateLowerStepsArgs \u003d [sequenceNr, procedureID]\n\tsystem.db.runPrepUpdate(updateLowerStepsQuery, updateLowerStepsArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\n\tdeleteSubSteps \u003d \u0027\u0027\u0027update\n\t\t\t\t\t\t\tSPSubStepsConfig\n\t\t\t\t\t\tset\n\t\t\t\t\t\t\tActive \u003d 0\n\t\t\t\t\t\twhere\n\t\t\t\t\t\t\tMainStepID \u003d ?\u0027\u0027\u0027\n\t\n\tdeleteSubStepsArgs \u003d [selectedStepID]\n\tsystem.db.runPrepUpdate(deleteSubSteps, deleteSubStepsArgs)\n\t\n\tsystem.perspective.sendMessage(\u0027refreshSteps\u0027)\n\t\n\tself.props.value \u003d 0"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "OneShotButton"
            },
