                "onActionPerformed": {
                  "config": {
                    "script": "\tselectedProcedureID \u003d self.parent.parent.getChild(\"FlexContainer_0\").getChild(\"Table\").props.selection.data[0].ProcedureID\n\t\n\tdeleteProceduresQuery \u003d \u0027\u0027\u0027\n\t\t\t\t\t\tdeclare @procedureID int \u003d ?;\n\t\t\t\t\t\t\n\t\t\t\t\t\tupdate \n\t\t\t\t\t\t\tSPProcedures\n\t\t\t\t\t\tset\n\t\t\t\t\t\t\tactive \u003d 0\n\t\t\t\t\t\twhere\n\t\t\t\t\t\t\tprocedureID \u003d @procedureID;\n\t\t\t\t\t\t\n\t\t\t\t\t\tupdate \n\t\t\t\t\t\t\tSPMainStepsConfig\n\t\t\t\t\t\tset\n\t\t\t\t\t\t\tactive \u003d 0\n\t\t\t\t\t\twhere\n\t\t\t\t\t\t\tprocedureID \u003d @procedureID;\n\t\t\t\t\t\t\n\t\t\t\t\t\tupdate \n\t\t\t\t\t\t\tSPSubStepsConfig\n\t\t\t\t\t\tset\n\t\t\t\t\t\t\tactive \u003d 0 \n\t\t\t\t\t\twhere \n\t\t\t\t\t\t\tMainStepID\n\t\t\t\t\t\tin (\n\t\t\t\t\t\t\tselect \n\t\t\t\t\t\t\t\tMainStepID\n\t\t\t\t\t\t\tfrom\n\t\t\t\t\t\t\t\tSPMainStepsConfig\n\t\t\t\t\t\t\twhere\n\t\t\t\t\t\t\t\tprocedureID \u003d @procedureID)\u0027\u0027\u0027\n\t\n\tdeleteProceduresArgs \u003d [selectedProcedureID]\n\tsystem.db.runPrepUpdate(deleteProceduresQuery, deleteProceduresArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\n\tself.props.value \u003d 0\n\tsystem.perspective.sendMessage(refreshProcedures)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
