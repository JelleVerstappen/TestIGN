{
  "custom": {},
  "params": {
    "Line": "E07",
    "Mandatory": 1,
    "Operand": "\u003d\u003d",
    "SubStepID": "value",
    "TagPath": "testPath",
    "Text": "test",
    "Value": 20,
    "index": "value",
    "typeCheck": "value"
  },
  "propConfig": {
    "params.Line": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.Mandatory": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.Operand": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.SubStepID": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.TagPath": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.Text": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.Value": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.index": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.typeCheck": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 551,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Dropdown"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.options": {
            "binding": {
              "config": {
                "queryPath": "StartupProcedures/getCheckTypes"
              },
              "type": "query"
            }
          },
          "props.params.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.typeCheck"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "params": {
            "enabled": true,
            "key": "Type check",
            "marginRight": 5,
            "placeholder": "Select...",
            "showClearIcon": true
          },
          "path": "Library/SharedTemplates/Input/Dropdown",
          "useDefaultViewHeight": true
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "String"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.Text"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "params": {
            "enabled": true,
            "key": "Tekst",
            "margingRight": 5,
            "placeholder": ""
          },
          "path": "Library/SharedTemplates/Input/String",
          "useDefaultViewHeight": true
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "EmbeddedView"
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "if({../Dropdown.props.params.value} \u003d 1, False, True)"
              },
              "type": "expr"
            }
          },
          "props.params.line": {
            "binding": {
              "config": {
                "path": "view.params.Line"
              },
              "type": "property"
            }
          },
          "props.params.operand": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.Operand"
              },
              "type": "property"
            }
          },
          "props.params.tagPath": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.TagPath"
              },
              "type": "property"
            }
          },
          "props.params.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.Value"
              },
              "type": "property"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "expression": "if({../Dropdown.props.params.value} \u003d 2,\r\n\t\u0027ControlRoom/StartupProcedure/Templates/MachineParameterCheckSettings\u0027,\r\n\t\u0027ControlRoom/StartupProcedure/Templates/ManualParameterCheckSettings\u0027)"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.view"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Checkbox"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.params.value": {
                "binding": {
                  "config": {
                    "expression": "toBoolean({view.params.Mandatory})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "params": {
                "checkBoxLeft": true,
                "enabled": true,
                "key": "Verplicht",
                "textPosition": "start"
              },
              "path": "Library/SharedTemplates/Input/Checkbox",
              "useDefaultViewHeight": true
            },
            "type": "ia.display.view"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tindex \u003d self.view.params.index\n\t\n\tsystem.perspective.sendMessage(\u0027deleteSubStep\u0027, {\u0027index\u0027: index})\n\tself.props.value \u003d 0"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "OneShotButton"
            },
            "position": {
              "basis": "45px",
              "shrink": 0
            },
            "props": {
              "confirm": {
                "enabled": true,
                "text": "Weet je het zeker?"
              },
              "readyState": {
                "icon": {
                  "path": "material/delete",
                  "style": {
                    "height": "24px",
                    "width": "2rem"
                  }
                },
                "text": ""
              },
              "style": {
                "classes": "ATA/Components/Buttons/Sec",
                "marginBottom": 5,
                "marginTop": 5
              },
              "writingState": {
                "icon": {
                  "path": "material/hourglass_empty",
                  "style": {
                    "height": "24px",
                    "width": "2rem"
                  }
                },
                "text": "Writing..."
              }
            },
            "type": "ia.input.oneshotbutton"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "marginRight": 5
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}