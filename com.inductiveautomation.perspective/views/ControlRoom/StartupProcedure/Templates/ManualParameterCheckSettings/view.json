{
  "custom": {},
  "params": {
    "operand": "value",
    "value": "value"
  },
  "propConfig": {
    "params.operand": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 120,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Operand"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.options": {
            "binding": {
              "config": {
                "queryPath": "StartupProcedures/getOperands"
              },
              "type": "query"
            }
          },
          "props.params.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.operand"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "params": {
            "enabled": true,
            "key": "Vergelijking",
            "marginRight": 5,
            "multiSelect": false,
            "placeholder": "Select...",
            "showClearIcon": true
          },
          "path": "Library/SharedTemplates/Input/Dropdown",
          "useDefaultViewHeight": true
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "params": {
            "enabled": true,
            "engUnits": "",
            "format": "0,0.##",
            "key": "Waarde",
            "maxValue": 10000000,
            "minValue": 0,
            "placeholder": "",
            "rejected": "True",
            "unitVisable": false
          },
          "path": "Library/SharedTemplates/Input/Number",
          "useDefaultViewHeight": true
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}