    "scripts": {
      "customMethods": [
        {
          "name": "new",
          "params": [],
          "script": "\tData \u003d {\u0027UnitID\u0027:int(-1),\u0027Description\u0027:\u0027\u0027 \n\t}\n\tFunction \u003d 0\n\t\n\tsystem.perspective.openDock(\u0027Units\u0027,params \u003d {\u0027Data\u0027:Data,\u0027Function\u0027:Function})"
        },
        {
          "name": "edit",
          "params": [],
          "script": "\tData \u003d self.getChild(\"Table\").props.selection.data[0]\n\tFunction \u003d 1\n\t\n\tsystem.perspective.openDock(\u0027Units\u0027,params \u003d {\u0027Data\u0027:Data,\u0027Function\u0027:Function})"
        },
        {
          "name": "delete",
          "params": [],
          "script": "\timport traceback\n\timport java.lang.Exception\n\timport sys.exc_info\n\tfrom java.lang import Throwable\n\timport java.io.IOException\n\t \n\t### Declare safety parameters\n\terrors \u003d []\n\tlogger \u003d system.util.getLogger(\u0027Units\u0027)\n\t \n\t#parameters\n\tmodifiedBy \u003d self.session.props.auth.user.userName if self.session.props.auth.authenticated else \"Unknown\"\n\ttableName \u003d \"Units\"\n\tdata \u003d self.getChild(\"Table\").props.selection.data[0]\n\tUnitID \u003d data.UnitID\n\tif UnitID\t \u003c 1:\n\t\terrors.append(system.util.translate(\"bewerken niet mogelijk, ID is lager dan 1. Probeer het opnieuw.\"))\n\t\t\n\telse:\n\t\tquery \u003d \"\"\"select count(*)\tfrom Parameters where UnitID \u003d ? and Active \u003d 1\"\"\"\n\t\tresult \u003d system.db.runScalarPrepQuery(query, args\u003d[UnitID])\n\t\tif result is not None and result !\u003d 0:\n\t\t\terrors.append(system.util.translate(\"Deze eenheid wordt nog gebruikt in {aantal} actieve parameters.\".format(aantal\u003dresult)))\n\t\t\n\t\t\n\tif not errors:\n\t\t### Try the following code\n\t\ttry:\n\t\t\tquery \u003d \"\"\"update Units \n\t\t\tset Active \u003d 0 \n\t\t\t, Modified \u003d getdate()\n\t\t\t,ModifiedBy \u003d ?\n\t\t\twhere UnitID \u003d ?\"\"\"\n\t\t\targs \u003d [modifiedBy,UnitID]\n\t\t\tresult \u003d system.db.runPrepUpdate(query, args)\n\t\n\t\t\t\t\n    ### When something fails, continue with the exception, e\n\t\texcept (Exception, Throwable, java.lang.Exception), e:\n\t\t\texType, ex, tb \u003d sys.exc_info()\n\t\t\tlogger.error(\"Exception on line %d: %s, %s\" % (traceback.tb_lineno(tb), exType, ex))\n\t\t\terrors.append(\"Error bij het opslaan, probeer nog eens. \"+str(e))\n\t\t        \n\t# if error is true show the error message.\n\tif errors:\n\t\ttimeout \u003d 20\n\t\terrors \u003d ata.function.uniqueList(errors)\n\t\terrorStr \u003d \"\u003cbr\u003e\".join(errors)\n\t\tlogger.error(errorStr)\t\n\t\tscreenID\u003dself.getChild(\"Toast Handler\").custom.screenID\n\t\tata.toast.handler.toasts.toastNotification(message\u003d\"Open voor foutmeldingen.\", timeout\u003dtimeout, sendTo\u003dself.session.props.id, backgroundColor\u003d\"--warning\", content\u003derrorStr,screenID\u003dscreenID)\n\telse:\n\t\t### Close the screen and refresh the overview\n\t\tsystem.perspective.sendMessage(\"RefreshUnits\", payload\u003d{}, scope\u003d\"session\")\n\t\t\t\t\t\n\t\t\t\t\t"
