              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tflowID \u003d self.view.params.flowID\n\tselectedStepID \u003d self.view.custom.selectedStep\n\tselectedStepIndex \u003d self.view.custom.selectedStepIndex\n\tcompletedStatus \u003d 3\n\t\n\tupdateQuery \u003d \u0027\u0027\u0027update \n\t\t\t\t\t\tSPStepLogging\n\t\t\t\t\tset\n\t\t\t\t\t\tcompleted \u003d getdate(),\n\t\t\t\t\t\tstatus \u003d ?\n\t\t\t\t\twhere\n\t\t\t\t\t\tFlowID \u003d ? and\n\t\t\t\t\t\tStepID \u003d ?\u0027\u0027\u0027\n\tupdateArgs \u003d [completedStatus, flowID, selectedStepID]\n\tsystem.db.runPrepUpdate(updateQuery, updateArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\n\tsystem.perspective.sendMessage(\u0027refreshStepsFlex\u0027)\n\t\n\tlineID \u003d self.view.params.LineID\n\tarticleID \u003d self.view.params.ArticleID\n\tprogressType \u003d \u0027Opstart\u0027\n\tcreatedBy \u003d self.session.props.auth.user.userName\n\tprogressStatus \u003d self.view.custom.selectedStepData.Name\n\tcomment \u003d self.parent.parent.getChild(\"EmbeddedView\").props.params.value\n\tcreationDate \u003d system.date.now()\n\t\n\tarticleNumber \u003d system.db.runScalarPrepQuery(\u0027select ArticleNumber from Articles where ArticleID \u003d ?\u0027, [articleID], database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\n\tAFType \u003d \u0027ProgressUpdate\u0027\n\tAFData \u003d  {\t\u0027LineID\u0027: lineID,\n\t\t\t\t\u0027ProgressType\u0027: progressType,\n\t\t\t\t\u0027ProgressStatus\u0027: progressStatus,\n\t\t\t\t\u0027Comment\u0027: comment,\n\t\t\t\t\u0027Article\u0027: articleNumber,\n\t\t\t\t\u0027Datetime\u0027: creationDate,\n\t\t\t\t\u0027CreatedBy\u0027: createdBy}\n\tdyka.activityFeed.addEntry(AFType, AFData)\n\t\n\tif selectedStepIndex + 1 \u003e\u003d len(self.parent.parent.parent.getChild(\"Overview\").getChild(\"FlexRepeater\").props.instances):\n\t\tcompleteFlowQuery \u003d \u0027\u0027\u0027\tUpdate\n\t\t\t\t\t\t\t\t\tSPFlowLogging\n\t\t\t\t\t\t\t\tset\n\t\t\t\t\t\t\t\t\tEnddate \u003d getdate()\n\t\t\t\t\t\t\t\twhere\n\t\t\t\t\t\t\t\t\tFlowID \u003d ?\u0027\u0027\u0027\n\t\tcompleteFlowArgs \u003d [flowID]\n\t\tsystem.db.runPrepUpdate(completeFlowQuery, completeFlowArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\t\t\n\t\tsystem.perspective.navigate(\u0027/\u0027)\n\t\treturn\n\t\n\tselectNewStepID \u003d self.parent.parent.parent.getChild(\"Overview\").getChild(\"FlexRepeater\").props.instances[selectedStepIndex + 1].stepID\n\tsystem.perspective.sendMessage(\u0027selectStep\u0027, payload \u003d {\u0027StepID\u0027: selectNewStepID})\n\t\n\tself.parent.parent.parent.getChild(\"Overview\").getChild(\"FlexContainer\").getChild(\"Progress\").refreshBinding(\u0027props.value\u0027)\n\tself.parent.parent.getChild(\"EmbeddedView\").props.params.value \u003d \u0027\u0027"
