  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\tflowID \u003d self.params.flowID\n\t\n\t# Select first step that\u0027s not yet completed\n\tfirstStepQuery \u003d \u0027\u0027\u0027select top(1)\n\t\t\t\t\t\t\tSPStepLogging.stepID\n\t\t\t\t\t\tfrom\n\t\t\t\t\t\t\tSPStepLogging\n\t\t\t\t\t\tleft join\n\t\t\t\t\t\t\tSPMainStepsConfig\n\t\t\t\t\t\ton\n\t\t\t\t\t\t\tSPStepLogging.StepID \u003d SPMainStepsConfig.StepID\n\t\t\t\t\t\twhere\n\t\t\t\t\t\t\tFlowID \u003d ?\n\t\t\t\t\t\t\tand\n\t\t\t\t\t\t\tCompleted is null\n\t\t\t\t\t\torder by sequenceNumber\u0027\u0027\u0027\n\tfirstStepArgs \u003d [flowID]\n\t\n\tfirstStep \u003d system.db.runScalarPrepQuery(firstStepQuery, firstStepArgs, database \u003d \u0027NLSTWDYK_DB_PROD\u0027)\n\tsystem.perspective.sendMessage(\u0027selectStep\u0027, {\u0027StepID\u0027: firstStep})"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "ArticleID": 1,
    "LineID": 1,
    "flowID": 10,
    "procedureID": 2
  },
  "propConfig": {
    "custom.selectedStep": {
      "persistent": true
    },
    "custom.selectedStepData": {
      "binding": {
        "config": {
          "struct": {
            "mainSteps": "{/root/Overview.custom.StepsData}",
            "selectedStepID": "{view.custom.selectedStep}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tselectedStepID \u003d value[\u0027selectedStepID\u0027]\n\tmainSteps \u003d value[\u0027mainSteps\u0027]\n\t\n\tfor step in mainSteps:\n\t\tif step[\u0027StepID\u0027] \u003d\u003d selectedStepID:\n\t\t\treturn step",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.selectedStepIndex": {
      "persistent": true
    },
    "params.ArticleID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.LineID": {
