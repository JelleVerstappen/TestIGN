                  "transforms": [
                    {
                      "code": "\tinstances \u003d []\n\t\n\tfor row in value:\n\t\tif row[\u0027Started\u0027] is not None:\n\t\t\tstartTimeDT \u003d system.date.fromMillis(row[\u0027Started\u0027])\n\t\t\tstartTimeFormatted \u003d system.date.format(startTimeDT, \u0027dd/MM/YYYY HH:mm:ss\u0027)\n\t\telse:\n\t\t\tstartTimeFormatted \u003d None\n\t\t\n\t\tif row[\u0027Completed\u0027] is not None:\n\t\t\tendTimeDT \u003d system.date.fromMillis(row[\u0027Completed\u0027] if row[\u0027Completed\u0027] is not None else 0)\n\t\t\tendTimeFormatted \u003d system.date.format(endTimeDT, \u0027dd/MM/YYYY HH:mm:ss\u0027)\n\t\telse:\n\t\t\tendTimeFormatted \u003d None\n\t\t\n\t\tinstance \u003d {\n\t\t\t  \"name\": row[\u0027Name\u0027],\n\t\t\t  \"endTime\": endTimeFormatted,\n\t\t\t  \"user\": row[\u0027CompletedBy\u0027],\n\t\t\t  \"status\": row[\u0027Status\u0027],\n\t\t\t  \"startTime\": startTimeFormatted,\n\t\t\t  \"stepID\": row[\u0027StepID\u0027],\n\t\t\t  \"flowID\": self.view.params.flowID\n#\t\t\t  \"selected\": None\n\t\t\t}\n\t\tinstances.append(instance)\n\treturn instances",
                      "type": "script"
