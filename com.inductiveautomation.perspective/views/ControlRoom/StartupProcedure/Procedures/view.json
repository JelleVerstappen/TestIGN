                  },
                  "transforms": [
                    {
                      "code": "\tinstances \u003d []\n\tflowID \u003d self.view.params.flowID\n\t\n\tfor row in range(value.getRowCount()):\n\t\trowData \u003d  system.util.jsonDecode(value.getValueAt(row, \u0027Data\u0027))\n\t\t\n\t\tinstance \u003d {\u0027name\u0027: rowData[\u0027Text\u0027],\n\t\t\t\t\t\u0027checkType\u0027: value.getValueAt(row, \u0027CheckTypeID\u0027),\n\t\t\t\t\t\u0027checkValue\u0027: rowData.get(\u0027Value\u0027),\n\t\t\t\t\t\u0027operand\u0027: rowData.get(\u0027Operand\u0027),\n\t\t\t\t\t\u0027tagPath\u0027: rowData.get(\u0027LinkedTag\u0027),\n\t\t\t\t\t\u0027flowID\u0027: flowID,\n\t\t\t\t\t\u0027subStepID\u0027: value.getValueAt(row, \u0027SubStepID\u0027),\n\t\t\t\t\t\u0027completed\u0027: value.getValueAt(row,\u0027Completed\u0027)}\n\t\tinstances.append(instance)\n\t\n\treturn instances",
                      "type": "script"
