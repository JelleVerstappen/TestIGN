{"onBarcodeDataReceived":"\t","onBluetoothReceived":"\t","onAccelerometerDataReceived":"\t","onNdefDataReceived":"\t","messageHandlers":[{"name":"toast-notification","enabled":true,"script":"\tata.toast.handler.session.addToast(payload)"},{"name":"toast-clearout","enabled":true,"script":"\tata.toast.handler.session.clearToast(**payload)"},{"name":"toast-timeout","enabled":true,"script":"\tata.toast.handler.session.closeToast(**payload)"}]}